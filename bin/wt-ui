#!/usr/bin/env python3
"""Terminal UI for wt: browse worktrees, see details and collisions, create and test.

Launched by `wt ui`. All git work goes through the `wt` script (WT_CMD) or read-only git calls.
"""
import curses
import datetime
import json
import locale
import os
import re
import shlex
import shutil
import subprocess
import sys
import textwrap
import threading
import time

WT = os.environ.get("WT_CMD", "wt")


ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")


def clean_error(text, fallback):
    """Strip colors and the 'wt: ' prefix from command stderr; fall back when empty."""
    lines = [ANSI_RE.sub("", l).rstrip() for l in text.splitlines()]
    lines = [re.sub(r"^wt: ", "", l) for l in lines if l.strip()]
    return "\n".join(lines) or fallback


def run(cmd, cwd=None, timeout=30):
    """Run a command, return (rc, stdout, stderr)."""
    try:
        env = dict(os.environ, NO_COLOR="1", GH_PROMPT_DISABLED="1", GIT_TERMINAL_PROMPT="0")
        p = subprocess.run(cmd, cwd=cwd, env=env, capture_output=True, text=True, timeout=timeout,
                           stdin=subprocess.DEVNULL)
        return p.returncode, p.stdout, p.stderr
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, "", str(e)


def parse_list(text):
    """Parse `wt list --porcelain` (path, branch, age, ahead, dirty, owner; tab-separated)."""
    rows = []
    for line in text.splitlines():
        parts = line.split("\t")
        if len(parts) != 6:
            continue
        path, branch, age, ahead, dirty, owner = parts
        rows.append({"path": path, "branch": branch, "age": age,
                     "ahead": ahead, "dirty": dirty, "owner": owner})
    return rows


def parse_collisions(text):
    """Parse `wt status` stderr into {branch: [(other_branch, [files])]}."""
    result = {}
    current = None
    for line in text.splitlines():
        m = re.match(r"^KOLIZJA (.+) ↔ (.+):$", line)
        if m:
            a, b = m.group(1), m.group(2)
            files = []
            result.setdefault(a, []).append((b, files))
            result.setdefault(b, []).append((a, files))
            current = files
        elif line.startswith("  ") and current is not None:
            current.append(line.strip())
        else:
            current = None
    return result


def parse_base(text):
    for line in text.splitlines():
        if line.startswith("baza:"):
            return line.split(":", 1)[1].strip()
    return ""


def parse_updown(text):
    """Parse `git rev-list --left-right --count @{upstream}...HEAD` into (behind, ahead); None if unparsable."""
    parts = text.split()
    if len(parts) == 2 and all(x.isdigit() for x in parts):
        return int(parts[0]), int(parts[1])
    return None


def load_main_info():
    """State of the main checkout: path, branch, (behind, ahead) of its upstream, changed files (git status --short)."""
    rc, out, _ = run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"])
    if rc != 0 or not out.strip():
        return None
    path = os.path.dirname(out.strip().rstrip("/"))
    _, br, _ = run(["git", "-C", path, "rev-parse", "--abbrev-ref", "HEAD"])
    rc, ud, _ = run(["git", "-C", path, "rev-list", "--left-right", "--count", "@{upstream}...HEAD"])
    _, up, _ = run(["git", "-C", path, "rev-parse", "--abbrev-ref", "@{upstream}"])
    _, st, _ = run(["git", "-C", path, "status", "--short"])
    return {"path": path, "branch": br.strip(), "updown": parse_updown(ud) if rc == 0 else None,
            "upstream": up.strip(), "changed": st.splitlines()}


def env_seconds(name, default):
    """Non-negative number of seconds from the environment; bad values fall back to the default."""
    try:
        v = float(os.environ.get(name, default))
    except ValueError:
        return default
    return v if v >= 0 else default


def worktree_gitdir(path):
    """Git dir of a checkout: `<path>/.git` itself, or the `gitdir:` target of a linked worktree's .git file."""
    dot = os.path.join(path, ".git")
    if os.path.isdir(dot):
        return dot
    try:
        with open(dot, encoding="utf-8") as f:
            line = f.readline().strip()
    except OSError:
        return None
    if not line.startswith("gitdir:"):
        return None
    gd = line[len("gitdir:"):].strip()
    return gd if os.path.isabs(gd) else os.path.normpath(os.path.join(path, gd))


def watch_paths(common, gitdirs):
    """Files and dirs whose stat changes whenever git commits, checks out, stages or adds/removes a worktree."""
    paths = []
    if common:
        paths += [os.path.join(common, n) for n in ("worktrees", "packed-refs", "config", "refs/heads")]
    for gd in gitdirs:
        if gd:
            paths += [os.path.join(gd, n) for n in ("HEAD", "index", "logs/HEAD")]
    return sorted(set(paths))


def fingerprint(paths):
    """Cheap change detector: (mtime, size, inode) per path via os.stat; no git process, works on macOS and Linux."""
    fp = []
    for p in paths:
        try:
            st = os.stat(p)
            fp.append((p, st.st_mtime_ns, st.st_size, st.st_ino))
        except OSError:
            fp.append((p, None))
    return tuple(fp)


def parse_branch_config(text, key):
    """Parse `git config --get-regexp` output for branch.<name>.<key> into {branch: value}."""
    out = {}
    for line in text.splitlines():
        m = re.match(r"^branch\.(.+)\.%s (.*)$" % re.escape(key), line)
        if m and m.group(2).strip():
            out[m.group(1)] = m.group(2).strip()
    return out


def created_ts(path):
    """When the worktree was created (epoch seconds): `time` in .wt-owner, else mtime of its .git file."""
    try:
        with open(os.path.join(path, ".wt-owner"), encoding="utf-8") as f:
            t = json.load(f).get("time", "")
        return datetime.datetime.strptime(t, "%Y-%m-%dT%H:%M:%S%z").timestamp()
    except (OSError, ValueError, AttributeError):
        pass
    try:
        return os.stat(os.path.join(path, ".git")).st_mtime
    except OSError:
        return None


def fmt_age(ts, now=None):
    """Short Polish age: teraz, 5min, 3h, 2d, 4mies, 1r. '?' when unknown."""
    if ts is None:
        return "?"
    sec = max(0, int((time.time() if now is None else now) - ts))
    if sec < 60:
        return "teraz"
    if sec < 3600:
        return f"{sec // 60}min"
    if sec < 86400:
        return f"{sec // 3600}h"
    days = sec // 86400
    if days < 60:
        return f"{days}d"
    return f"{days // 30}mies" if days < 365 else f"{days // 365}r"


def check_bucket(c):
    """One gh check (CheckRun or StatusContext) as 'red' | 'yellow' | 'green'."""
    concl = (c.get("conclusion") or "").upper()
    status = (c.get("status") or "").upper()
    state = (c.get("state") or "").upper()  # StatusContext entries
    if concl in ("FAILURE", "TIMED_OUT", "CANCELLED", "STARTUP_FAILURE", "ACTION_REQUIRED") \
            or state in ("FAILURE", "ERROR"):
        return "red"
    if (status and status != "COMPLETED") or state in ("PENDING", "EXPECTED"):
        return "yellow"
    return "green"


def check_list(checks):
    """[(name, bucket)] for every dict entry of statusCheckRollup."""
    return [(str(c.get("name") or c.get("context") or "?"), check_bucket(c))
            for c in checks or [] if isinstance(c, dict)]


def ci_state(checks):
    """Reduce gh statusCheckRollup to 'green' | 'yellow' | 'red' | 'none'."""
    buckets = [b for _, b in check_list(checks)]
    if not buckets:
        return "none"
    return "red" if "red" in buckets else "yellow" if "yellow" in buckets else "green"


def parse_conflict_files(text):
    """Files from `git merge-tree --write-tree --name-only`: lines after the tree id, up to a blank line."""
    lines = text.splitlines()[1:]
    out = []
    for ln in lines:
        if not ln.strip():
            break
        out.append(ln.strip())
    return out


def parse_prs(text):
    """Map `gh pr list --json ...` output to {headRefName: pr}; prefers an open PR, then the newest."""
    try:
        data = json.loads(text)
    except ValueError:
        return {}
    out = {}
    for pr in data if isinstance(data, list) else []:
        if not isinstance(pr, dict) or not pr.get("headRefName") or not isinstance(pr.get("number"), int):
            continue
        item = {"number": pr["number"], "draft": bool(pr.get("isDraft")),
                "state": (pr.get("state") or "").upper(),
                "mergeable": (pr.get("mergeable") or "").upper(),
                "ci": ci_state(pr.get("statusCheckRollup")), "url": pr.get("url") or "",
                "checks": check_list(pr.get("statusCheckRollup")), "base": pr.get("baseRefName") or ""}
        old = out.get(pr["headRefName"])
        if old is None or (item["state"] == "OPEN", item["number"]) > (old["state"] == "OPEN", old["number"]):
            out[pr["headRefName"]] = item
    return out


PR_FIELDS = "number,headRefName,baseRefName,isDraft,state,mergeable,statusCheckRollup,url"


