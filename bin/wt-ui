def parse_config(text):
    """Parse `wt config --porcelain` (key, source, value, default; tab-separated) into dicts."""
    items = []
    for line in text.splitlines():
        parts = line.split("\t")
        if len(parts) != 4:
            continue
        items.append({"key": parts[0], "source": parts[1], "value": parts[2], "default": parts[3]})
    return items


def conf_problems(text):
    """Lines of a wt.conf that `wt` would silently ignore: no '=' or an unknown key. Pure."""
    problems = []
    for n, line in enumerate(text.splitlines(), start=1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            problems.append("linia %d: brak '=' (zignorowana)" % n)
            continue
        key = re.sub(r"\s+", "", line.split("=", 1)[0])
        if key not in CONFIG_HELP:
            problems.append("linia %d: nieznany klucz %s (zignorowany)" % (n, key))
    return problems


def config_notes(item):
    """Short explanation lines for one config item: [(text, style-name)]. Pure."""
    desc, shared_ok = CONFIG_HELP.get(item["key"], ("", False))
    notes = []
    if item["source"] == "env":
        notes.append(("Ustawione zmienną środowiskową: nadpisuje wszystkie pliki konfiguracyjne.", "yellow"))
    elif item["source"] == "domyślna":
        notes.append(("Wartość domyślna (nic tego klucza nie ustawia).", "dim"))
    notes.append(("Wspólny .wt.conf: " + ("dozwolony." if shared_ok else "niedozwolony (klucz z komendą, tylko prywatnie)."), "dim"))
    return desc, notes


def trunc(s, n):
    """Cut s to n cells, marking the cut with an ellipsis (whole characters only)."""
    if n <= 0:
        return ""
    return s if len(s) <= n else s[:n - 1] + "…"


class App:
    def __init__(self, scr):
        self.scr = scr
        self.rows = []
        self.collisions = {}
        self.base = ""
        self.cursor = 0
        self.on_header = False  # focus on the header (main checkout) instead of the list
        self.main = None
        self.top = 0
        self.body_h = 1
        self.filter = ""
        self.message = ""
        self.pending_error = None
        self.detail_cache = {}
        self.show_help = False
        self.menu = "main"  # which Space menu is shown: main | pr
        self.menu_note = ""  # why the last pressed (disabled) menu entry is unavailable
        self.pending_g = False  # first g of gg
        self.cancelled = False
        self.overlay = None     # callable drawing a full-screen view instead of the main layout
        self.cfg = {}
        self.meta = {}          # branch -> {"title", "target", "created"}
        self.prs = {}           # branch -> PR info (from gh), filled in the background
        self.pr_status = "off"  # off (no gh) | loading | ok | err
        self.pr_gen = 0
        self.fetch_status = "off"  # off | loading | ok | err (background `git fetch origin`)
        self.fetch_gen = 0
        # autorefresh: full reload every WT_UI_POLL s (0 = off), stat check of .git every WT_UI_STAT s
        self.poll = env_seconds("WT_UI_POLL", 30)
        self.stat_every = env_seconds("WT_UI_STAT", 2)
        self.auto = self.poll > 0
        self.refresh_gen = 0
        self.refreshing = False
        self.snapshot = None    # result of a background collect(), applied by the UI thread
        self.watched = []
        self.last_fp = None
        self.next_stat = self.next_poll = 0.0
        self.init_style()
        self.reload()

    # ---- style and safe drawing primitives ----

    def init_style(self):
        """Colors (256-color shades with an 8-color fallback) and box/glyph sets."""
        enc = (locale.getpreferredencoding(False) or "").lower()
        self.utf8 = "utf" in enc
        if self.utf8:
            self.bx = dict(tl="╭", tr="╮", bl="╰", br="╯", h="─", v="│")
            self.sym = dict(busy="●", sel="▸", ok="✓", arrow="→", cut="…", up="↑", ci="●", wait="…",
                            warn="!", dot="·", bar="▌", sep="─")
        else:
            self.bx = dict(tl=curses.ACS_ULCORNER, tr=curses.ACS_URCORNER, bl=curses.ACS_LLCORNER,
                           br=curses.ACS_LRCORNER, h=curses.ACS_HLINE, v=curses.ACS_VLINE)
            self.sym = dict(busy="*", sel=">", ok="v", arrow="->", cut="~", up="^", ci="o", wait="..",
                            warn="!", dot="|", bar="|", sep="-")
        c = dict(plain=0, head=curses.A_BOLD, dim=curses.A_DIM)
        try:
            curses.use_default_colors()
        except curses.error:
            pass
        if curses.has_colors():
            rich = curses.COLORS >= 256
            # name: (256-color fg, 8-color fg); backgrounds stay default (-1) so the theme shows through
            spec = {"border": (111, curses.COLOR_BLUE), "accent": (117, curses.COLOR_CYAN),
                    "green": (114, curses.COLOR_GREEN), "yellow": (222, curses.COLOR_YELLOW),
                    "red": (211, curses.COLOR_RED), "mag": (183, curses.COLOR_MAGENTA),
                    "title": (189, curses.COLOR_WHITE)}
            for i, (name, (fg256, fg8)) in enumerate(spec.items(), start=1):
                try:
                    curses.init_pair(i, fg256 if rich else fg8, -1)
                    c[name] = curses.color_pair(i)
                except curses.error:
                    c[name] = 0
            try:
                # Selected row: dark text on a colored background (good contrast on any theme).
                curses.init_pair(20, 235 if rich else curses.COLOR_BLACK,
                                 117 if rich else curses.COLOR_CYAN)
                c["sel"] = curses.color_pair(20) | curses.A_BOLD
            except curses.error:
                c["sel"] = curses.A_REVERSE
            if rich:
                try:
                    curses.init_pair(21, 245, -1)
                    c["dim"] = curses.color_pair(21)
                except curses.error:
                    pass
                # Focused list item: same colors on a soft dark-gray background (keeps the theme's pastels readable).
                shades = {"plain": 252, "dim": 247, "border": 111, "accent": 117, "green": 114,
                          "yellow": 222, "red": 211, "mag": 183, "title": 189}
                for j, (name, fg) in enumerate(shades.items()):
                    try:
                        curses.init_pair(40 + j, fg, 238)
                        c["s_" + name] = curses.color_pair(40 + j)
                    except curses.error:
                        pass
            try:
                # Menu: every style on solid black so the layout underneath never shows through.
                black = 16 if rich else curses.COLOR_BLACK
                mshades = {"plain": (252, curses.COLOR_WHITE), "dim": (245, curses.COLOR_WHITE),
                           "border": (111, curses.COLOR_BLUE), "accent": (117, curses.COLOR_CYAN),
                           "green": (114, curses.COLOR_GREEN), "yellow": (222, curses.COLOR_YELLOW),
                           "red": (211, curses.COLOR_RED)}
                for j, (name, (fg256, fg8)) in enumerate(mshades.items()):
                    curses.init_pair(60 + j, fg256 if rich else fg8, black)
                    c["m_" + name] = curses.color_pair(60 + j)
            except curses.error:
                pass
        else:
            c["sel"] = curses.A_REVERSE
        for name in ("plain", "dim", "border", "accent", "green", "yellow", "red"):
            c.setdefault("m_" + name, c.get(name, 0) if name != "plain" else 0)
        for name in ("accent", "green"):
            c["m_" + name + "b"] = c["m_" + name] | curses.A_BOLD
        for name in ("border", "accent", "green", "yellow", "red", "mag", "title"):
            c.setdefault(name, 0)
        c["redb"] = c["red"] | curses.A_BOLD
        c["accentb"] = c["accent"] | curses.A_BOLD
        c["greenb"] = c["green"] | curses.A_BOLD
        c["titleb"] = c["title"] | curses.A_BOLD
        # Focused-row variants: s_<name>; without 256 colors the whole row is simply reversed/highlighted.
        for name in ("plain", "dim", "border", "accent", "green", "yellow", "red", "mag", "title"):
            c.setdefault("s_" + name, c["sel"])
        for name in ("red", "accent", "green", "title"):
            c["s_" + name + "b"] = c["s_" + name] | curses.A_BOLD
        self.c = c

    def put(self, y, x, s, attr=0, maxw=None):
        """Safe addstr: clips to the screen (and maxw), never raises."""
        h, w = self.scr.getmaxyx()
        if y < 0 or y >= h or x >= w or not s:
            return
        if x < 0:
            s, x = s[-x:], 0
        avail = w - x if maxw is None else min(w - x, maxw)
        s = s[:max(0, avail)]
        if not s:
            return
        try:
            self.scr.addstr(y, x, s, attr)
        except curses.error:
            pass  # writing the bottom-right cell raises after the char is already drawn

    def put_ch(self, y, x, ch, attr=0):
        h, w = self.scr.getmaxyx()
        if y < 0 or y >= h or x < 0 or x >= w:
            return
        try:
            if isinstance(ch, str):
                self.scr.addstr(y, x, ch, attr)
            else:
                self.scr.addch(y, x, ch, attr)
        except curses.error:
            pass

    def segs(self, y, x, parts, maxw):
        """Draw (text, style-name) parts left to right, clipped to maxw cells."""
        used = 0
        for text, style in parts:
            if used >= maxw:
                break
            self.put(y, x + used, text, self.c[style], maxw - used)
            used += len(text)

    def fill(self, y, x, h, w):
        for i in range(h):
            self.put(y + i, x, " " * w)

    def box(self, y, x, h, w, style="border", title=None, tstyle="accentb", clear=False):
        """Rounded box; the title is woven into the top edge: ╭─── Title ───╮."""
        if h < 2 or w < 2:
            return
        if clear:
            self.fill(y, x, h, w)
        a, b = self.bx, self.c[style]
        for i in range(1, w - 1):
            self.put_ch(y, x + i, a["h"], b)
            self.put_ch(y + h - 1, x + i, a["h"], b)
        for i in range(1, h - 1):
            self.put_ch(y + i, x, a["v"], b)
            self.put_ch(y + i, x + w - 1, a["v"], b)
        self.put_ch(y, x, a["tl"], b)
        self.put_ch(y, x + w - 1, a["tr"], b)
        self.put_ch(y + h - 1, x, a["bl"], b)
        self.put_ch(y + h - 1, x + w - 1, a["br"], b)
        if title and w > 10:
            t = " " + trunc(title, w - 10) + " "
            self.put(y, x + 4, t, self.c[tstyle], w - 5)

    # ---- data ----

    @staticmethod
    def collect():
        """Read all list data without touching the UI (safe to run in a background thread)."""
        rc, out, err = run([WT, "list", "--porcelain"])
        if rc != 0:
            return {"error": clean_error(err, "wt list nie powiodło się")}
        rows = parse_list(out)
        _, sout, serr = run([WT, "status"])
        _, cout, cerr = run([WT, "config"])
        _, tt, _ = run(["git", "config", "--get-regexp", r"^branch\..*\.wt-title$"])
        _, tg, _ = run(["git", "config", "--get-regexp", r"^branch\..*\.wt-target$"])
        titles, targets = parse_branch_config(tt, "wt-title"), parse_branch_config(tg, "wt-target")
        meta = {r["branch"]: {"title": titles.get(r["branch"], ""), "target": targets.get(r["branch"], ""),
                              "created": created_ts(r["path"])} for r in rows}
        main = load_main_info()
        common = os.path.join(main["path"], ".git") if main else None
        gitdirs = [worktree_gitdir(p) for p in [r["path"] for r in rows] + ([main["path"]] if main else [])]
        watched = watch_paths(common, gitdirs)
        return {"rows": rows, "collisions": parse_collisions(serr + sout), "base": parse_base(cout + cerr),
                "meta": meta, "main": main, "watched": watched, "fp": fingerprint(watched)}

    def apply(self, snap, silent=False):
        """Swap in a collected snapshot, keeping the cursor on the same worktree path."""
        if "error" in snap:
            self.message = "! wt list nie powiodło się"
            self.rows = []
            if not silent:
                self.pending_error = ("Błąd", snap["error"])
            return
        rows = self.visible()
        cur = rows[self.cursor]["path"] if rows and 0 <= self.cursor < len(rows) else None
        self.rows, self.collisions, self.base = snap["rows"], snap["collisions"], snap["base"]
        self.meta, self.main = snap["meta"], snap["main"]
        self.watched, self.last_fp = snap["watched"], snap["fp"]
        self.detail_cache = {}
        paths = [r["path"] for r in self.visible()]
        if cur in paths:
            self.cursor = paths.index(cur)
        now = time.monotonic()
        self.next_poll = now + self.poll
        self.next_stat = now + self.stat_every
        self.start_pr_fetch(silent=silent)

    def reload(self):
        self.refresh_gen += 1  # drop any background refresh still in flight
        self.refreshing = False
        self.apply(self.collect())
        self.start_remote_fetch()  # network fetch only on start, r and after actions; not on autorefresh

    def start_remote_fetch(self):
        """`git fetch origin` in the background so behind/ahead reflect the real remote (never blocks)."""
        if not self.main:
            return
        self.fetch_gen += 1
        gen = self.fetch_gen
        self.fetch_status = "loading"
        path = self.main["path"]

        def work():
            rc, _, _ = run(["git", "-C", path, "fetch", "--quiet", "--prune", "origin"], timeout=30)
            if gen != self.fetch_gen:
                return
            if rc == 0:
                self.main = load_main_info()
                self.fetch_status = "ok"
            else:
                self.fetch_status = "err"  # offline / no origin: keep last-known numbers
        threading.Thread(target=work, daemon=True).start()

    def pull_main(self):
        """Fast-forward the main checkout to its upstream (git pull --ff-only), after confirmation."""
        mi = self.main
        if not mi or mi["updown"] is None:
            self.message = "! główna gałąź nie ma upstreamu"
            return
        behind, ahead = mi["updown"]
        if not behind:
            self.message = "nic do pobrania (0 w tyle)"
            return
        if ahead:
            self.pending_error = ("Nie można przewinąć",
                                  f"{mi['branch']} ma {ahead} lokalnych commitów, których nie ma na {mi['upstream']}.\n"
                                  "Rozwiąż ręcznie (git pull --rebase albo push).")
            return
        if not self.confirm(f"Pobrać {behind} commitów z {mi['upstream']} do {mi['branch']} (ff-only)?"):
            return
        fail = self.run_steps([{"argv": ["git", "-C", mi["path"], "pull", "--ff-only", "--quiet"]}], "git pull --ff-only")
        if fail:
            self.pending_error = ("git pull nie powiódł się", fail[1])
            self.message = "! git pull nie powiódł się"
            return
        self.reload()
        self.message = f"pobrano {behind} commitów do {mi['branch']}"

    def start_refresh(self):
        """Background reload; the UI thread applies the result in loop(). At most one in flight."""
        if self.refreshing:
            return
        self.refreshing = True
        self.refresh_gen += 1
        gen = self.refresh_gen

        def work():
            snap = self.collect()
            if gen == self.refresh_gen:
                self.snapshot = snap
        threading.Thread(target=work, daemon=True).start()

    def tick(self):
        """Called from loop() on every getch timeout; returns True when the screen needs a redraw."""
        snap, self.snapshot = self.snapshot, None
        if snap is not None:
            self.refreshing = False
            self.apply(snap, silent=True)
            return True
        if not self.auto or self.refreshing:
            return False
        now = time.monotonic()
        if now >= self.next_poll:
            self.start_refresh()
        elif self.stat_every and now >= self.next_stat:
            self.next_stat = now + self.stat_every
            if fingerprint(self.watched) != self.last_fp:
                self.start_refresh()
        return self.refreshing

    def start_pr_fetch(self, silent=False):
        """Fetch PR/CI data for all branches in one background `gh` call (optional, never blocks)."""
        if not shutil.which("gh"):
            self.pr_status = "off"
            return
        self.pr_gen += 1
        gen = self.pr_gen
        if not (silent and self.pr_status == "ok"):  # autorefresh keeps showing the current PR data
            self.pr_status = "loading"

        def work():
            rc, out, _ = run(["gh", "pr", "list", "--state", "all", "--limit", "100", "--json", PR_FIELDS],
                             timeout=20)
            if gen != self.pr_gen:
                return
            if rc == 0:
                self.prs = parse_prs(out)
                self.pr_status = "ok"
            else:
                self.pr_status = "err"  # no network / no remote / not logged in: keep old data silently
        threading.Thread(target=work, daemon=True).start()

    def visible(self):
        if not self.filter:
            return self.rows
        f = self.filter.lower()
        return [r for r in self.rows
                if f in r["branch"].lower() or f in self.meta.get(r["branch"], {}).get("title", "").lower()]

    # ---- dialogs ----

    def confirm(self, question):
        h, w = self.scr.getmaxyx()
        self.put(h - 1, 0, (question + " [y/n] ").ljust(w - 1), self.c["sel"], w - 1)
        self.scr.refresh()
        return self.scr.getch() in (ord("y"), ord("Y"))

    def modal(self, title, text):
        """Red rounded error box centered on screen; dismissed with Enter, Space or Esc."""
        scr = self.scr
        while True:
            self.draw(refresh=False)
            h, w = scr.getmaxyx()
            box_w = max(12, min(w - 4, 76))
            body = []
            for line in text.splitlines() or [""]:
                body += textwrap.wrap(line, max(1, box_w - 6), subsequent_indent="  ") or [""]
            max_body = max(1, h - 8)
            if len(body) > max_body:
                body = body[:max_body - 1] + ["..."]
            box_h = len(body) + 5
            y0, x0 = max(0, (h - box_h) // 2), max(0, (w - box_w) // 2)
            # Red foreground on the default background (never white-on-red: unreadable on pastel themes).
            self.box(y0, x0, box_h, box_w, style="red", title=title, tstyle="redb", clear=True)
            for i, line in enumerate(body):
                self.put(y0 + 2 + i, x0 + 3, line, 0, box_w - 6)
            label = "[ OK ]"
            self.put(y0 + box_h - 2, x0 + max(1, (box_w - len(label)) // 2), label,
                     self.c["red"] | curses.A_REVERSE | curses.A_BOLD)
            scr.refresh()
            key = scr.getch()
            if key in (10, 13, 27, ord(" "), curses.KEY_ENTER):
                return

    def confirm_box(self, title, lines, steps):
        """Confirmation modal: what will happen + exact commands. y/Enter = yes, n/Esc = no."""
        scr = self.scr
        while True:
            self.draw(refresh=False)
            h, w = scr.getmaxyx()
            box_w = max(20, min(w - 4, 86))
            inner = max(1, box_w - 6)
            body = []
            for line in lines:
                body += textwrap.wrap(line, inner) or [""]
            body.append("")
            body.append("Komendy:")
            for st in steps:
                body += ["  $ " + l if i == 0 else "    " + l for i, l in
                         enumerate(textwrap.wrap(display_cmd(st["argv"], WT), max(1, inner - 4),
                                                 break_long_words=True) or [""])]
            max_body = max(1, h - 8)
            if len(body) > max_body:
                body = body[:max_body - 1] + ["..."]
            box_h = len(body) + 5
            y0, x0 = max(0, (h - box_h) // 2), max(0, (w - box_w) // 2)
            self.box(y0, x0, box_h, box_w, style="yellow", title=title, tstyle="accentb", clear=True)
            for i, line in enumerate(body):
                self.put(y0 + 2 + i, x0 + 3, line, self.c["dim"] if line.startswith("  ") else 0, box_w - 6)
            self.put(y0 + box_h - 2, x0 + 3, "[ y / Enter: tak ]   [ n / Esc: nie ]", self.c["accentb"], box_w - 6)
            scr.refresh()
            key = scr.getch()
            if key in (ord("y"), ord("Y"), 10, 13, curses.KEY_ENTER):
                return True
            if key in (ord("n"), ord("N"), 27, ord("q")):
                return False

    def prompt(self, title, initial=""):
        """Nvim-cmdline style input window; returns the stripped text, "" on Esc (self.cancelled set)."""
        scr = self.scr
        buf, pos = list(initial), len(initial)
        self.cancelled = False
        while True:
            self.draw(refresh=False)
            h, w = scr.getmaxyx()
            bw = max(12, min(w - 4, 64))
            x0, y0 = max(0, (w - bw) // 2), max(0, h // 4 - 1)
            self.box(y0, x0, 3, bw, style="border", title=title, tstyle="accentb", clear=True)
            avail = max(1, bw - 7)
            start = 0 if pos < avail else pos - avail + 1
            self.put(y0 + 1, x0 + 2, ">", self.c["accentb"])
            self.put(y0 + 1, x0 + 4, "".join(buf[start:start + avail]), 0, avail)
            under = buf[pos] if pos < len(buf) else " "
            self.put(y0 + 1, x0 + 4 + pos - start, under, curses.A_REVERSE)
            scr.refresh()
            try:
                ch = scr.get_wch()
            except curses.error:
                continue
            except KeyboardInterrupt:
                ch = "\x1b"
            if isinstance(ch, str):
                if ch in ("\n", "\r"):
                    return "".join(buf).strip()
                if ch == "\x1b":
                    self.cancelled = True
                    return ""
                if ch in ("\x7f", "\b"):
                    if pos:
                        del buf[pos - 1]
                        pos -= 1
                elif ch == "\x01":
                    pos = 0
                elif ch == "\x05":
                    pos = len(buf)
                elif ch == "\x15":
                    buf, pos = [], 0
                elif ch.isprintable() and len(buf) < 200:
                    buf.insert(pos, ch)
                    pos += 1
            elif ch == curses.KEY_BACKSPACE:
                if pos:
                    del buf[pos - 1]
                    pos -= 1
            elif ch == curses.KEY_DC:
                if pos < len(buf):
                    del buf[pos]
            elif ch == curses.KEY_LEFT:
                pos = max(0, pos - 1)
            elif ch == curses.KEY_RIGHT:
                pos = min(len(buf), pos + 1)
            elif ch == curses.KEY_HOME:
                pos = 0
            elif ch == curses.KEY_END:
                pos = len(buf)
            elif ch == curses.KEY_ENTER:
                return "".join(buf).strip()

    # ---- drawing ----

    def details(self, row):
        """Detail lines as lists of (text, style-name) parts (cached per worktree)."""
        key = row["path"]
        if key in self.detail_cache:
            return self.detail_cache[key]
        if self.base:
            _, out, _ = run(["git", "-C", row["path"], "log", "--oneline", "-n", "8",
                             f"{self.base}..HEAD"])
            commits = out.strip().splitlines()
            # Commits reachable from no origin/* ref = not pushed yet (uses last fetch, no network).
            rc, out, _ = run(["git", "-C", row["path"], "rev-list", "--abbrev-commit", "HEAD",
                              "--not", "--remotes=origin", f"^{self.base}"])
            local = set(out.split()) if rc == 0 else None
        else:
            commits, local = [], None
        _, out, _ = run(["git", "-C", row["path"], "status", "--short"])
        changed = out.strip().splitlines()
        lines = []
        lines.append([(f"Commity ponad {self.base or 'bazą'}", "accentb")])
        for cm in commits:
            sha, _, msg = cm.partition(" ")
            mark = commit_mark(sha, local)
            lines.append([("  " + mark[0] + " ", mark[1]), (sha + " ", "yellow"), (msg, "plain")])
        if not commits:
            lines.append([("  (brak)", "dim")])
        elif local is not None:
            n = sum(1 for cm in commits if commit_mark(cm.split(" ", 1)[0], local)[0] == "↑")
            lines.append([("  ✓ na origin   ↑ tylko lokalnie", "dim"),
                          (f"   ({n} do wypchnięcia)" if n else "   (wszystko wypchnięte)", "yellow" if n else "dim")])
        lines.append([])
        lines.append([("Zmiany niezacommitowane", "accentb")])
        for ch in changed[:15]:
            code = ch[:2].strip()
            style = "red" if "D" in code else "green" if code in ("A", "??") else "yellow"
            lines.append([("  " + ch[:2], style), (ch[2:], "plain")])
        if not changed:
            lines.append([("  " + self.sym["ok"] + " czysto", "green")])
        if len(changed) > 15:
            lines.append([(f"  ... i {len(changed) - 15} więcej", "dim")])
        self.detail_cache[key] = lines
        return lines

    def pr_badge(self, branch):
        """(text, style) parts for the PR column: 'PR #50 draft', CI icon; None when gh is unavailable."""
        pr = self.prs.get(branch)
        if pr:
            txt = f"PR #{pr['number']}"
            if pr["state"] == "MERGED":
                txt += " merged"
            elif pr["state"] == "CLOSED":
                txt += " closed"
            elif pr["draft"]:
                txt += " draft"
            ci = {"green": "green", "yellow": "yellow", "red": "redb", "none": "dim"}[pr["ci"]]
            icon = self.sym["ci"] if self.utf8 else {"green": "g", "yellow": "y", "red": "r", "none": "-"}[pr["ci"]]
            if pr["state"] != "OPEN":
                return [(txt, "dim")]
            return [(txt + " ", "accent"), (icon, ci)]
        if self.pr_status == "loading":
            return [("PR " + self.sym["wait"], "dim")]
        if self.pr_status == "ok":
            return [("brak PR", "dim")]
        return None

    def conflict_notes(self, r):
        """Conflict warnings: overlap with other worktrees (wt status) and PR conflict with its target."""
        notes = []
        others = [o for o, _ in self.collisions.get(r["branch"], [])]
        if others:
            notes.append("kolizja: " + ", ".join(others))
        pr = self.prs.get(r["branch"])
        if pr and pr["state"] == "OPEN" and pr["mergeable"] == "CONFLICTING":
            notes.append("konflikt z targetem PR")
        return notes

    def item_lines(self, r, w):
        """The three lines of a list item as (left parts, right parts), each a list of (text, style)."""
        m = self.meta.get(r["branch"], {})
        busy = r["owner"] != "wolny"
        dirty = r["dirty"] != "0"
        notes = self.conflict_notes(r)
        bstyle = "redb" if notes else "yellow" if dirty else "greenb"
        l1 = [(self.sym["busy"] if busy else " ", "mag"), (self.sym["warn"] if notes else " ", "redb"),
              (" " + r["branch"], bstyle)]
        r1 = self.pr_badge(r["branch"]) or []
        if m.get("title"):
            l2 = [("   " + m["title"], "titleb")]
        elif m.get("target"):
            l2 = [("   " + self.sym["arrow"] + " " + m["target"], "accent")]
        else:
            l2 = [("   (bez tytułu)", "dim")]
        r2 = [(" ".join(notes), "redb")] if notes else []
        ahead = r["ahead"] != "0"
        sep = (" " + self.sym["dot"] + " ", "dim")
        l3 = [("   utw. " + fmt_age(m.get("created")), "dim"), sep,
              ("commity +" + r["ahead"], "green" if ahead else "dim"), sep,
              ("zmiany " + ("~" + r["dirty"] if dirty else "0"), "yellow" if dirty else "dim")]
        return [(l1, r1), (l2, r2), (l3, [])]

    def draw_list(self, rows, y0, x0, ph, pw):
        self.box(y0, x0, ph, pw, title="Worktree")
        iw, ih = pw - 2, ph - 2
        cap = max(1, (ih + 1) // ITEM_PITCH)
        if not rows:
            self.put(y0 + 1, x0 + 2, "brak worktree (n = nowy)", self.c["dim"], iw - 1)
        for i, r in enumerate(rows[self.top:self.top + cap]):
            idx = self.top + i
            y = y0 + 1 + i * ITEM_PITCH
            selected = idx == self.cursor and not self.on_header
            if i > 0 and y - 1 < y0 + ph - 1:  # thin separator between items
                self.put(y - 1, x0 + 3, self.sym["sep"] * max(0, iw - 4), self.c["border"] | curses.A_DIM)
            if selected:
                for k in range(ITEM_H):
                    self.put(y + k, x0 + 1, " " * iw, self.c["s_plain"])
            for k, (left, right) in enumerate(self.item_lines(r, iw)):
                if y + k >= y0 + ph - 1:
                    break
                if selected:
                    bar = self.sym["bar"] if self.utf8 else (">" if k == 0 else "|")
                    marker = (bar + " ", "s_accentb")
                    left = [(t, "s_" + st if "s_" + st in self.c else "s_plain") for t, st in left]
                    right = [(t, "s_" + st if "s_" + st in self.c else "s_plain") for t, st in right]
                else:
                    marker = ("  ", "plain")
                avail = iw - 1
                rlen = sum(len(t) for t, _ in right)
                if rlen > avail // 2:  # keep at least half of the width for the left side
                    right = [(trunc(right[0][0], avail // 2), right[0][1])] if len(right) == 1 else right
                    rlen = sum(len(t) for t, _ in right)
                    if rlen > avail // 2:
                        right, rlen = [], 0
                lw = max(1, avail - rlen - (1 if rlen else 0))
                text = "".join(t for t, _ in left)
                if len(text) + 2 > lw:  # shorten the last left part with an ellipsis
                    over = len(text) + 2 - lw
                    t, st = left[-1]
                    left = left[:-1] + [(trunc(t, max(1, len(t) - over)), st)]
                self.segs(y + k, x0 + 1, [marker] + left, avail)
                if rlen:
                    self.segs(y + k, x0 + 1 + iw - rlen - 1, right, rlen)
        if len(rows) > cap:
            tag = f" {self.cursor + 1}/{len(rows)} "
            self.put(y0 + ph - 1, x0 + pw - len(tag) - 2, tag, self.c["dim"])

    def conflict_files(self, r, pr):
        """Files that would conflict when merging the branch into the PR base (cached; needs git >= 2.38)."""
        key = ("conf", r["branch"], pr["number"])
        if key in self.detail_cache:
            return self.detail_cache[key]
        base = pr.get("base") or self.base
        files = []
        if base:
            ref = f"origin/{base}"
            rc, _, _ = run(["git", "-C", r["path"], "rev-parse", "--verify", "--quiet", ref])
            if rc != 0:
                ref = base
            rc, out, _ = run(["git", "-C", r["path"], "merge-tree", "--write-tree", "--name-only",
                              "--no-messages", ref, r["branch"]])
            if rc == 1:
                files = parse_conflict_files(out)
        self.detail_cache[key] = files
        return files

    def draw_detail(self, rows, y0, x0, ph, pw):
        r = rows[self.cursor] if rows else None
        self.box(y0, x0, ph, pw, title="Szczegóły")
        if not r:
            return
        iw = pw - 4
        m = self.meta.get(r["branch"], {})
        owner_style = "mag" if r["owner"] != "wolny" else "dim"
        lab = lambda t: (t.ljust(15), "dim")
        lines = [[(r["branch"], "greenb")],
                 [(r["path"] if len(r["path"]) <= iw else "…" + r["path"][-(iw - 1):], "dim")],
                 []]
        if m.get("title"):  # worktree title: prominent block between the path and the metadata
            for ln in textwrap.wrap(m["title"], max(10, iw - 2))[:3]:
                lines.append([(ln, "titleb")])
            lines.append([(self.sym["sep"] * min(iw, 40), "border")])
        lines.append([])
        if m.get("target"):
            lines.append([lab("target"), (m["target"], "accent")])
        created = m.get("created")
        age = fmt_age(created)
        lines.append([lab("utworzony"), (age + ("" if age in ("teraz", "?") else " temu"), "plain")])
        if created:
            lines.append([lab(""), (time.strftime("%Y-%m-%d %H:%M", time.localtime(created)), "dim")])
        lines += [[lab("ost. commit"), (r["age"], "plain")],
                  [lab("commity"), ("+" + r["ahead"] + " ponad bazą", "green" if r["ahead"] != "0" else "dim")],
                  [lab("zmiany"), (r["dirty"] + " niezacommitowanych" if r["dirty"] != "0" else "brak",
                                   "yellow" if r["dirty"] != "0" else "dim")],
                  [lab("właściciel"), (r["owner"], owner_style)]]
        pr = self.prs.get(r["branch"])
        if pr:
            st = {"OPEN": "otwarty", "MERGED": "zmergowany", "CLOSED": "zamknięty"}.get(pr["state"], pr["state"])
            lines.append([lab("PR"), (f"#{pr['number']} {st}" + (", draft" if pr["draft"] else ""), "accent")])
            civ = {"green": ("przechodzi", "green"), "yellow": ("trwa", "yellow"),
                   "red": ("błąd", "redb"), "none": ("brak", "dim")}[pr["ci"]]
            lines.append([lab("CI"), (self.sym["ci"] + " ", civ[1]), (civ[0], civ[1])])
            words = {"green": "przechodzi", "yellow": "trwa", "red": "błąd"}
            for cname, bucket in pr.get("checks", [])[:8]:
                lines.append([lab(""), (self.sym["ci"] + " ", {"green": "green", "yellow": "yellow", "red": "redb"}[bucket]),
                              (cname, "plain"), ("  " + words[bucket], "dim")])
            if len(pr.get("checks", [])) > 8:
                lines.append([lab(""), (f"... i {len(pr['checks']) - 8} więcej", "dim")])
            if pr["mergeable"] == "CONFLICTING":
                lines.append([lab("konflikt z PR"), ("tak - wymaga rozwiązania", "redb")])
                for cf in self.conflict_files(r, pr)[:8]:
                    lines.append([lab(""), ("! " + cf, "red")])
            elif pr["mergeable"] == "MERGEABLE":
                lines.append([lab("konflikt z PR"), ("brak", "green")])
            if pr["url"]:
                lines.append([lab("link"), (pr["url"], "dim")])
        elif self.pr_status == "loading":
            lines.append([lab("PR"), ("wczytuję " + self.sym["wait"], "dim")])
        elif self.pr_status == "ok":
            lines.append([lab("PR"), ("brak", "dim")])
        lines.append([])
        for other, files in self.collisions.get(r["branch"], []):
            lines.append([("! Kolizja z ", "redb"), (other, "redb")])
            lines += [[("    " + f, "red")] for f in files[:8]]
            lines.append([])
        lines += self.details(r)
        for i, parts in enumerate(lines[:ph - 2]):
            self.segs(y0 + 1 + i, x0 + 2, parts, iw)

    def header_parts(self, rows, focus):
        """(text, style) parts of the header line; styles get the focused-row variants when focus is set."""
        pre = "s_" if focus else ""
        sty = lambda n: pre + n
        parts = [(" wt ", sty("accentb")), ("│ ", sty("border")), (f"worktree: {len(rows)}", sty("plain"))]
        if self.base:
            parts += [("  │ ", sty("border")), ("baza: ", sty("dim")), (self.base, sty("greenb"))]
        mi = self.main
        if mi:
            ud = mi["updown"]
            if ud is None:
                parts += [("  │ ", sty("border")), ("origin: ", sty("dim")), ("brak upstreamu", sty("dim"))]
            elif ud == (0, 0):
                parts += [("  │ ", sty("border")), ("origin: ", sty("dim")), (self.sym["ok"] + " zgodny", sty("green"))]
            else:
                parts += [("  │ ", sty("border")), ("origin: ", sty("dim")),
                          (f"↓{ud[0]} w tyle", sty("yellow") if ud[0] else sty("dim")), (" · ", sty("dim")),
                          (f"↑{ud[1]} do przodu", sty("accent") if ud[1] else sty("dim"))]
                if ud[0] and not ud[1]:
                    parts += [("  (U = pobierz)", sty("dim"))]
            if ud is not None and self.fetch_status == "loading":
                parts += [(" · sprawdzam…", sty("dim"))]
            elif ud is not None and self.fetch_status == "err":
                parts += [(" · offline, stan z ostatniego fetch", sty("dim"))]
            n = len(mi["changed"])
            parts += [("  │ ", sty("border")), ("zmiany: ", sty("dim")),
                      (f"{n} niezacommitowanych" if n else "brak", sty("yellow") if n else sty("dim"))]
        if self.filter:
            parts += [("  │ ", sty("border")), ("filtr: ", sty("dim")), (self.filter, sty("yellow"))]
        if self.refreshing:
            parts += [("  │ ", sty("border")), ("odświeżanie…", sty("dim"))]
        elif self.auto:
            parts += [("  │ ", sty("border")), (f"auto {self.poll:g}s", sty("dim"))]
        return parts

    def draw_header(self, rows, w):
        """Header block with padding above and below; focusable (k at the top of the list) to show the main checkout."""
        y = HDR_H // 2
        if self.on_header:
            for i in range(HDR_H):
                self.put(i, 0, " " * (w - 1), self.c["s_plain"])
            self.put(y, 0, self.sym["bar"], self.c["s_accentb"])
        self.segs(y, 1, self.header_parts(rows, self.on_header), w - 2)

    def draw_main_detail(self, y0, x0, ph, pw):
        self.box(y0, x0, ph, pw, title="Szczegóły: checkout główny")
        mi = self.main
        if not mi:
            self.put(y0 + 1, x0 + 2, "brak danych o głównym checkoucie", self.c["dim"], pw - 4)
            return
        iw = pw - 4
        lab = lambda t: (t.ljust(15), "dim")
        ud = mi["updown"]
        lines = [[(mi["branch"] or "?", "greenb")],
                 [(mi["path"] if len(mi["path"]) <= iw else "…" + mi["path"][-(iw - 1):], "dim")], [],
                 [lab("baza wt"), (self.base or "?", "accent")]]
        if mi["updown"] is None:
            lines.append([lab("origin"), ("brak upstreamu dla tej gałęzi", "dim")])
        else:
            lines.append([lab("origin"), (mi["upstream"], "accent")])
            lines.append([lab("w tyle"), (f"{ud[0]} commitów", "yellow" if ud[0] else "dim"),
                          ("  (U = pobierz: git pull --ff-only)" if ud[0] else "", "dim")])
            lines.append([lab("do przodu"), (f"{ud[1]} commitów", "accent" if ud[1] else "dim"),
                          ("  (niewypchnięte)" if ud[1] else "", "dim")])
        fetch_note = {"loading": "pobieram stan z origin…", "ok": "stan z origin aktualny (fetch przy starcie / r)",
                      "err": "fetch nie powiódł się, stan z ostatniego fetch"}.get(self.fetch_status, "stan z ostatniego fetch")
        lines.append([lab(""), (fetch_note, "dim")])
        changed = mi["changed"]
        lines += [[], [("Zmiany niezacommitowane", "accentb")]]
        room = max(1, ph - len(lines) - 3)
        for ch in changed[:room]:
            code = ch[:2].strip()
            style = "red" if "D" in code else "green" if code in ("A", "??") else "yellow"
            lines.append([("  " + ch[:2], style), (ch[2:], "plain")])
        if not changed:
            lines.append([("  " + self.sym["ok"] + " czysto", "green")])
        if len(changed) > room:
            lines.append([(f"  ... i {len(changed) - room} więcej", "dim")])
        for i, parts in enumerate(lines[:ph - 2]):
            self.segs(y0 + 1 + i, x0 + 2, parts, iw)

    def menu_columns(self):
        """Columns of the current menu as (header, entries): categories, or the PR submenu."""
        if self.menu == "pr":
            rows = self.visible()
            row = rows[min(self.cursor, len(rows) - 1)] if rows else None
            if not row:
                return [("Opcje PR", PR_MENU)]
            st = self.pr_state(row)
            entries = [(k, d, st[k]) if k in st and st[k] else (k, d) for k, d in PR_MENU]
            return [("Opcje PR", entries)]
        if self.menu in ("open", "copy"):
            st = self.sub_state(self.open_target())
            header, items = ("Otwórz", OPEN_MENU) if self.menu == "open" else ("Kopiuj", COPY_MENU)
            return [(header, [(k, d, st[k]) if st.get(k) else (k, d) for k, d in items])]
        return MENU

    def open_target(self):
        """Row the Open submenu acts on: the focused worktree, or the main repo on the header."""
        rows = self.visible()
        if self.on_header:
            return self.main
        return rows[min(self.cursor, len(rows) - 1)] if rows else None

    def sub_state(self, row):
        """Disabled entries of the current Open/Copy submenu for row."""
        pr = self.prs.get(row["branch"]) if row and row.get("branch") else None
        fn = open_menu_state if self.menu == "open" else copy_menu_state
        return fn(row, pr, self.pr_status, bool(shutil.which("gh")))

    def pr_state(self, row):
        return pr_menu_state(row, self.prs.get(row["branch"]), self.pr_status, bool(shutil.which("gh")))

    def draw_help(self, h, w):
        """Yazi-like key hint menu docked to the bottom: category columns on solid black."""
        cols = self.menu_columns()
        sep = self.sym["arrow"]
        widths = []
        for head, entries in cols:
            kw = max(len(e[0]) for e in entries)
            widths.append((kw, max(len(head), max(kw + 3 + len(e[1]) + (len(e[2][0]) + 3 if len(e) > 2 else 0)
                                                  for e in entries)) + 3))
        # Greedy grid: put columns side by side while they fit, wrap to a new band otherwise.
        bands, cur, used = [], [], 0
        for i, (kw, cw) in enumerate(widths):
            if cur and used + cw > w - 3:
                bands.append(cur)
                cur, used = [], 0
            cur.append(i)
            used += cw
        bands.append(cur)
        note = textwrap.wrap(self.menu_note, max(10, w - 6))[:2] if self.menu in ("pr", "open", "copy") and self.menu_note else []
        need = len(note) + sum(1 + max(len(cols[i][1]) for i in band) + (1 if n else 0) for n, band in enumerate(bands))
        ph = min(h - 1, need + 2)
        y0 = h - ph
        black = self.c["m_plain"]
        for i in range(ph):
            self.put(y0 + i, 0, " " * (w - 1), black)
            self.put_ch(y0 + i, w - 1, " ", black)
        self.box(y0, 0, ph, w, style="m_border", title={"pr": "Menu / PR", "open": "Menu / Otwórz", "copy": "Menu / Kopiuj"}.get(self.menu, "Menu"), tstyle="m_accentb")
        y = y0 + 1
        for n, band in enumerate(bands):
            if n:
                y += 1
            x = 2
            for i in band:
                head, entries = cols[i]
                kw, cw = widths[i]
                self.put(y, x, head, self.c["m_accentb"], max(0, w - 2 - x))
                for r, e in enumerate(entries):
                    if y + 1 + r >= y0 + ph - 1:
                        break
                    k, d = e[0], e[1]
                    if len(e) > 2:  # disabled entry: dimmed, with the short reason
                        parts = [(k.rjust(kw), "m_dim"), (" " + sep + " ", "m_dim"), (d, "m_dim"),
                                 (" (" + e[2][0] + ")", "m_yellow")]
                    else:
                        parts = [(k.rjust(kw), "m_greenb"), (" " + sep + " ", "m_dim"), (d, "m_plain")]
                    self.segs(y + 1 + r, x, parts, max(0, w - 2 - x))
                x += cw
            y += 1 + max(len(cols[i][1]) for i in band)
        for n, line in enumerate(note):
            self.put(y0 + ph - 1 - len(note) + n, 2, line, self.c["m_red"] | curses.A_BOLD, max(0, w - 4))

    def draw(self, refresh=True):
        scr = self.scr
        scr.erase()
        h, w = scr.getmaxyx()
        if self.overlay and w >= MIN_W and h >= MIN_H:
            self.overlay()  # e.g. the config screen: replaces the main layout, dialogs draw on top
            if refresh:
                scr.refresh()
            return
        if w < MIN_W or h < MIN_H:
            self.put(h // 2, max(0, (w - 12) // 2), "okno za małe", self.c["redb"])
            self.put(h // 2 + 1, max(0, (w - 11) // 2), "q = wyjście", self.c["dim"])
            if refresh:
                scr.refresh()
            return
        rows = self.visible()
        self.cursor = max(0, min(self.cursor, len(rows) - 1))
        ph = h - HDR_H - 2
        self.body_h = body_h = max(1, (ph - 1) // ITEM_PITCH)
        if self.cursor < self.top:
            self.top = self.cursor
        elif self.cursor >= self.top + body_h:
            self.top = self.cursor - body_h + 1
        self.top = max(0, min(self.top, max(0, len(rows) - body_h)))
        left_w = min(max(36, w * 9 // 20), w - 20)

        self.draw_header(rows, w)
        self.draw_list(rows, HDR_H, 0, ph, left_w)
        if self.on_header:
            self.draw_main_detail(HDR_H, left_w, ph, w - left_w)
        else:
            self.draw_detail(rows, HDR_H, left_w, ph, w - left_w)

        if self.show_help:
            self.draw_help(h, w)
        else:
            msg = self.message
            style = "redb" if msg.startswith("!") else "green" if msg.startswith("+") else "dim"
            self.put(h - 2, 1, msg, self.c[style], w - 2)
            self.segs(h - 1, 1, [("<Space>", "accentb"), (" skróty  ", "dim"), ("q", "accentb"),
                                 (" wyjście", "dim")], w - 2)
        if refresh:
            scr.refresh()

    # ---- actions ----

    def local_branches(self):
        """Local branch names (for the target dropdown), base first."""
        _, out, _ = run(["git", "for-each-ref", "--format=%(refname:short)", "refs/heads"])
        names = [b for b in out.split() if b]
        if self.base in names:
            names.remove(self.base)
            names.insert(0, self.base)
        return names

    def pick(self, title, items, current):
        """Popup list under the form; returns the chosen index (or current on Esc)."""
        scr, idx = self.scr, current
        while True:
            self.draw(refresh=False)
            self.form_draw()
            h, w = scr.getmaxyx()
            n = min(len(items), max(1, h - 8))
            bw = max(12, min(w - 8, 40))
            x0, y0 = max(0, (w - bw) // 2), self.form_y + 3
            top = max(0, min(idx - n + 1, len(items) - n)) if idx >= n else 0
            self.box(y0, x0, n + 2, bw, title=title, clear=True)
            for i in range(n):
                it = items[top + i]
                sel = top + i == idx
                self.put(y0 + 1 + i, x0 + 1, (" " + it).ljust(bw - 2), self.c["sel"] if sel else 0, bw - 2)
            scr.refresh()
            try:
                ch = scr.get_wch()
            except curses.error:
                continue
            except KeyboardInterrupt:
                return current
            if ch in ("\n", "\r", " ", curses.KEY_ENTER):
                return idx
            if ch == "\x1b":
                return current
            if ch in ("k", curses.KEY_UP):
                idx = max(0, idx - 1)
            elif ch in ("j", curses.KEY_DOWN):
                idx = min(len(items) - 1, idx + 1)

    def form_draw(self):
        """Draw the new-worktree form from self.form (state dict)."""
        f = self.form
        scr = self.scr
        h, w = scr.getmaxyx()
        bw = max(30, min(w - 4, 64))
        x0, y0 = max(0, (w - bw) // 2), max(0, h // 4 - 1)
        self.form_y = y0
        self.box(y0, x0, 7, bw, title="Nowy worktree", clear=True)
        labels = ("Target", "Nazwa", "Tytuł")
        avail = max(1, bw - 15)
        for i, lab in enumerate(labels):
            y = y0 + 1 + i
            foc = f["focus"] == i
            self.put(y, x0 + 2, lab.ljust(7), self.c["accentb"] if foc else self.c["dim"])
            if i == 0:
                txt = f["branches"][f["target"]] if f["branches"] else "(brak gałęzi)"
                self.put(y, x0 + 10, "[ " + trunc(txt, avail - 4) + " ▾ ]" if self.utf8 else
                         "[ " + trunc(txt, avail - 4) + " v ]",
                         self.c["sel"] if foc else self.c["border"], avail)
            else:
                buf, pos = f["buf"][i], f["pos"][i]
                start = 0 if pos < avail else pos - avail + 1
                self.put(y, x0 + 10, ">", self.c["accentb"] if foc else self.c["dim"])
                shown = "".join(buf[start:start + avail - 2])
                if not buf and not foc and i == 2:
                    self.put(y, x0 + 12, "(opcjonalny)", self.c["dim"])
                else:
                    self.put(y, x0 + 12, shown, 0, avail - 2)
                if foc:
                    under = buf[pos] if pos < len(buf) else " "
                    self.put(y, x0 + 12 + pos - start, under, curses.A_REVERSE)
        self.put(y0 + 5, x0 + 2, "Tab/↑↓ pole   Enter dalej/utwórz   Esc anuluj" if self.utf8 else
                 "Tab/up/down field  Enter next/create  Esc cancel", self.c["dim"], bw - 4)

    def new_form(self):
        """Modal form: target branch dropdown + name + optional title. Returns (name, target, title) or None."""
        scr = self.scr
        branches = self.local_branches()
        self.form = f = dict(focus=1, branches=branches, target=0,
                             buf={1: [], 2: []}, pos={1: 0, 2: 0})
        while True:
            self.draw(refresh=False)
            self.form_draw()
            scr.refresh()
            try:
                ch = scr.get_wch()
            except curses.error:
                continue
            except KeyboardInterrupt:
                return None
            foc = f["focus"]
            if ch == "\x1b":
                return None
            if ch in ("\t", curses.KEY_DOWN):
                f["focus"] = (foc + 1) % 3
                continue
            if ch in (curses.KEY_BTAB, curses.KEY_UP):
                f["focus"] = (foc - 1) % 3
                continue
            if foc == 0:
                if ch in ("\n", "\r", " ", curses.KEY_ENTER) and branches:
                    f["target"] = self.pick("Target branch", branches, f["target"])
                elif ch in ("j", curses.KEY_RIGHT, "l") and branches:
                    f["target"] = (f["target"] + 1) % len(branches)
                elif ch in ("k", curses.KEY_LEFT, "h") and branches:
                    f["target"] = (f["target"] - 1) % len(branches)
                continue
            buf, pos = f["buf"][foc], f["pos"][foc]
            if isinstance(ch, str):
                if ch in ("\n", "\r"):
                    if foc == 1 and not buf:
                        continue
                    if foc == 1:
                        f["focus"] = 2
                        continue
                    if not f["buf"][1]:
                        f["focus"] = 1
                        continue
                    return ("".join(f["buf"][1]).strip(), branches[f["target"]] if branches else "",
                            "".join(f["buf"][2]).strip())
                if ch in ("\x7f", "\b"):
                    if pos:
                        del buf[pos - 1]
                        pos -= 1
                elif ch == "\x01":
                    pos = 0
                elif ch == "\x05":
                    pos = len(buf)
                elif ch == "\x15":
                    buf.clear()
                    pos = 0
                elif ch.isprintable() and len(buf) < 200:
                    buf.insert(pos, ch)
                    pos += 1
            elif ch == curses.KEY_BACKSPACE:
                if pos:
                    del buf[pos - 1]
                    pos -= 1
            elif ch == curses.KEY_DC:
                if pos < len(buf):
                    del buf[pos]
            elif ch == curses.KEY_LEFT:
                pos = max(0, pos - 1)
            elif ch == curses.KEY_RIGHT:
                pos = min(len(buf), pos + 1)
            elif ch == curses.KEY_HOME:
                pos = 0
            elif ch == curses.KEY_END:
                pos = len(buf)
            elif ch == curses.KEY_ENTER:
                f["focus"] = 2 if foc == 1 else foc
            f["pos"][foc] = pos

    def new(self):
        res = self.new_form()
        if not res or not res[0]:
            return
        name, target, title = res
        self.message = f"tworzę {name}..."
        self.draw()
        cmd = [WT, "new", name]
        if target:
            cmd += ["--target", target]
        if title:
            cmd += ["--title", title]
        rc, out, err = run(cmd, timeout=120)
        self.reload()
        if rc == 0:
            for i, r in enumerate(self.visible()):
                if r["branch"] == name:
                    self.cursor = i
            self.message = f"+ {name}"
        else:
            self.message = f"! wt new {name} nie powiodło się"
            self.modal(f"wt new {name}: błąd", clean_error(err, "wt new nie powiodło się"))

    def run_tests(self, row):
        """Suspend curses, run `wt test` in the worktree, wait for a key."""
        curses.def_prog_mode()
        curses.endwin()
        print(f"\n== wt test w {row['path']} ==\n", flush=True)
        try:
            rc = subprocess.call([WT, "test"], cwd=row["path"])
        except OSError as e:
            print(e)
            rc = 1
        input(f"\n[koniec, kod {rc}] Enter wraca do UI ")
        curses.reset_prog_mode()
        self.scr.refresh()
        self.reload()
        self.message = "testy: OK" if rc == 0 else f"testy: kod wyjścia {rc}"

    def run_steps(self, steps, label):
        """Run steps in a background thread with a spinner; returns None or (step, error text)."""
        res = {"done": False, "fail": None}

        def work():
            for st in steps:
                rc, out, err = run(st["argv"], cwd=st.get("cwd"), timeout=120)
                if rc != 0:
                    res["fail"] = (st, clean_error(err or out, "polecenie zwróciło błąd"))
                    break
            res["done"] = True
        threading.Thread(target=work, daemon=True).start()
        frames, i = "-\\|/", 0
        while not res["done"]:
            self.message = f"{frames[i % 4]} {label}..."
            self.draw()
            self.scr.timeout(100)
            self.scr.getch()  # keys pressed meanwhile are discarded
            i += 1
        self.scr.timeout(-1)
        return res["fail"]

    def act(self, kind, row):
        """Plan, confirm, run and report one action on the focused worktree."""
        plan = plan_action(kind, row, self.meta.get(row["branch"], {}), self.prs.get(row["branch"]),
                           self.base, self.pr_status, bool(shutil.which("gh")), WT)
        if plan.get("error"):
            self.message = "! " + plan["error"].splitlines()[0]
            self.modal("Nie można wykonać", plan["error"])
            return
        if not self.confirm_box(plan["title"], plan["lines"], plan["steps"]):
            self.message = "anulowano"
            return
        steps = plan["steps"]
        fail = self.run_steps(steps, plan["title"])
        # Processes running inside the worktree block `wt drop`; offer to stop them and retry from that step.
        if fail and "działają procesy" in fail[1]:
            rest = steps[steps.index(fail[0]):]
            rest = [dict(st, argv=st["argv"] + ["--stop-procs"]) if st["argv"][:2] == [WT, "drop"] else st for st in rest]
            if self.confirm_box("Procesy w worktree", fail[1].splitlines() + ["", "Zatrzymać je (SIGTERM, nigdy kill -9) i ponowić?"], rest):
                fail = self.run_steps(rest, plan["title"])
        self.reload()  # also re-reads PR state from GitHub (source of truth)
        if fail:
            st, text = fail
            self.message = f"! {plan['title']} nie powiodło się"
            self.modal(f"{plan['title']}: błąd", f"$ {display_cmd(st['argv'], WT)}\n{text}")
        else:
            self.message = f"+ {plan['title']}: gotowe"

    def copy_cd(self, row):
        cmd = f"cd {row['path']}"
        self.copy_text(cmd, f"skopiowano: {cmd}")

    def copy_text(self, text, done_msg):
        """Put text on the clipboard (pbcopy); show it in a modal when pbcopy is unavailable."""
        try:
            p = subprocess.run(["pbcopy"], input=text, text=True, timeout=5)
            self.message = done_msg if p.returncode == 0 else "! pbcopy zwrócił błąd"
        except (OSError, subprocess.TimeoutExpired):
            self.message = "! brak pbcopy"
            self.modal("Schowek niedostępny", f"Brak pbcopy. Skopiuj ręcznie:\n{text}")

    def open_vscode(self, row):
        """Open the worktree in VS Code: `code` CLI if on PATH, else macOS `open -a`. Detached."""
        path = row["path"]
        if shutil.which("code"):
            argv = ["code", path]
        elif shutil.which("open"):
            argv = ["open", "-a", "Visual Studio Code", path]
        else:
            self.message = "! brak polecenia code (VS Code: Shell Command: Install 'code')"
            return
        try:
            p = subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                               stderr=subprocess.PIPE, text=True, timeout=15)
            self.message = (f"VS Code: {path}" if p.returncode == 0
                            else "! VS Code: " + (p.stderr.strip().splitlines() or ["błąd"])[-1])
        except (OSError, subprocess.TimeoutExpired) as e:
            self.message = f"! nie udało się otworzyć VS Code: {e}"

    def open_pr_browser(self, row):
        """Open the row's PR page in the default browser via macOS `open`."""
        pr = self.prs.get(row.get("branch") or "")
        if not pr or not pr["url"]:
            self.message = "! brak PR dla tej gałęzi (Space, p, p tworzy draft)"
            return
        try:
            p = subprocess.run(["open", pr["url"]], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, timeout=15)
            self.message = f"przeglądarka: PR #{pr['number']}" if p.returncode == 0 else "! open zwrócił błąd"
        except (OSError, subprocess.TimeoutExpired) as e:
            self.message = f"! nie udało się otworzyć przeglądarki: {e}"

    def config_load(self):
        """Fetch the effective config: (items, error-text)."""
        rc, out, err = run([WT, "config", "--porcelain"])
        items = parse_config(out) if rc == 0 else []
        return items, ("" if items else clean_error(err, "wt config nie powiodło się"))

    def config_paint(self):
        """Draw the config screen (also used as the backdrop of the edit prompt and error modal)."""
        scr = self.scr
        items, cur, notes = self.cfg["items"], self.cfg["cur"], self.cfg["notes"]
        h, w = scr.getmaxyx()
        self.box(0, 0, h, w, title="Konfiguracja")
        iw = w - 4
        kw = max(len(i["key"]) for i in items)
        sw = min(24, max(len(i["source"]) for i in items))
        # VALUE gets a bounded column so the description column fits; no description on narrow terminals.
        vw = min(22, max(7, max(len(i["value"] or "(puste)") for i in items)))
        dw = iw - 2 - (kw + 2) - (sw + 2) - (vw + 2)
        head = [("KLUCZ".ljust(kw + 2), "dim"), ("ŹRÓDŁO".ljust(sw + 2), "dim")]
        if dw >= 14:
            head += [("WARTOŚĆ".ljust(vw + 2), "dim"), ("OPIS", "dim")]
        else:
            head += [("WARTOŚĆ", "dim")]
        self.segs(1, 2, head, iw)
        for n, it in enumerate(items):
            y = 2 + n
            if y >= h - 2:
                break
            sel = n == cur
            st = (lambda name: "s_" + name if "s_" + name in self.c else "s_plain") if sel else (lambda name: name)
            src_style = "yellow" if it["source"] == "env" else "dim" if it["source"] == "domyślna" else "green"
            val_style = "dim" if (not it["value"] or it["source"] == "domyślna") else "accent"
            if sel:
                self.put(y, 1, " " * (w - 2), self.c["s_plain"])
            bar = self.sym["bar"] if sel else " "
            row = [(bar + " ", st("accentb")), (it["key"].ljust(kw + 2), st("plain")),
                   (trunc(it["source"], sw).ljust(sw + 2), st(src_style))]
            if dw >= 14:
                brief = CONFIG_BRIEF.get(it["key"], ("", []))[0]
                row += [(trunc(it["value"] or "(puste)", vw).ljust(vw + 2), st(val_style)), (trunc(brief, dw), st("dim"))]
            else:
                row += [(it["value"] or "(puste)", st(val_style))]
            self.segs(y, 1, row, w - 2)
        it = items[cur]
        desc, hints = config_notes(it)
        y = 3 + len(items)
        if y < h - 3:
            self.put(y, 2, self.sym["sep"] * max(0, iw), self.c["border"] | curses.A_DIM)
            y += 1
            lines = [(l, "plain") for l in textwrap.wrap(desc, max(10, iw))]
            lines += [("", "plain"), ("Wartość:   " + (it["value"] or "(puste)"), "plain"),
                      ("Domyślna:  " + (it["default"] or "(puste)"), "plain"),
                      ("Źródło:    " + it["source"], "plain")]
            ex = CONFIG_BRIEF.get(it["key"], ("", []))[1]
            if ex:
                lines += [("Przykłady:  " + "   |   ".join(ex), "accent")]
            lines += [("", "plain")]
            for text, style in hints:
                lines += [(l, style) for l in textwrap.wrap(text, max(10, iw))]
            for text, style in lines:
                if y >= h - 2:
                    break
                self.put(y, 2, text, self.c[style], iw)
                y += 1
        # Result of the last edit sits just above the footer.
        flat = []
        for text, style in notes:
            flat += [(l, style) for l in textwrap.wrap(text, max(10, iw))]
        for n, (text, style) in enumerate(flat[-3:]):
            self.put(h - 1 - len(flat[-3:]) + n, 2, text, self.c[style], iw)
        self.put(h - 1, 3, " j/k ruch  Enter edytuj  d przywróć domyślną  E plik w edytorze  Esc wróć ", self.c["dim"], max(0, w - 6))

    def config_screen(self):
        """Config screen: browse the effective config and edit keys through `wt config set/unset`.

        Everything is written by `wt` itself, only to the private .git/wt.conf (never the shared .wt.conf).
        """
        items, err = self.config_load()
        if not items:
            self.pending_error = ("Błąd", err)
            return
        self.cfg = {"items": items, "cur": 0, "notes": []}
        self.overlay = self.config_paint
        changed = False
        pending_g = False
        try:
            while True:
                self.draw()
                key = self.scr.getch()
                if key in (curses.KEY_RESIZE, -1):
                    continue
                if key == ord("g") and not pending_g:
                    pending_g = True
                    continue
                gg = pending_g and key == ord("g")
                pending_g = False
                cfg = self.cfg
                it = cfg["items"][cfg["cur"]]
                if key in (27, ord("q"), ord("h"), ord("C"), curses.KEY_BACKSPACE, 127, 8):
                    break
                if key in (curses.KEY_DOWN, ord("j")):
                    cfg["cur"] = min(len(cfg["items"]) - 1, cfg["cur"] + 1)
                elif key in (curses.KEY_UP, ord("k")):
                    cfg["cur"] = max(0, cfg["cur"] - 1)
                elif key == curses.KEY_HOME or gg:
                    cfg["cur"] = 0
                elif key in (curses.KEY_END, ord("G")):
                    cfg["cur"] = len(cfg["items"]) - 1
                elif key in (10, 13, curses.KEY_ENTER):
                    value = self.prompt("Ustaw %s (zapis do .git/wt.conf)" % it["key"], it["value"])
                    if self.cancelled:
                        continue
                    args = ["set", it["key"], value]
                    if it["key"] == "WT_DIR" and value != it["value"] and self.rows and self.confirm(
                            "Przenieść %d istniejących worktree do nowego katalogu?" % len(self.rows)):
                        args.append("--move")
                    changed |= self.config_apply(args)
                elif key == ord("E"):
                    changed |= self.config_edit_file()
                elif key == ord("d"):
                    if self.confirm("Usunąć %s z .git/wt.conf (wróci wartość z niższego źródła)?" % it["key"]):
                        changed |= self.config_apply(["unset", it["key"]])
        finally:
            self.overlay = None
        if changed:
            self.reload()
            self.message = "+ zapisano konfigurację"

    def config_edit_file(self):
        """Open the private .git/wt.conf in $VISUAL/$EDITOR (curses suspended), then re-read the config."""
        if not self.main:
            self.modal("Błąd", "Nie znaleziono głównego checkoutu.")
            return False
        path = os.path.join(self.main["path"], ".git", "wt.conf")
        editor = shlex.split(os.environ.get("VISUAL") or os.environ.get("EDITOR") or "vi")
        before = open(path).read() if os.path.exists(path) else None
        curses.def_prog_mode()
        curses.endwin()
        err = ""
        try:
            subprocess.call(editor + [path])
        except OSError as e:
            err = "Nie udało się uruchomić edytora '%s': %s" % (" ".join(editor), e)
        curses.reset_prog_mode()
        self.scr.clear()
        self.scr.refresh()
        if err:
            self.modal("Błąd", err)
            return False
        after = open(path).read() if os.path.exists(path) else None
        items, _ = self.config_load()
        if items:
            self.cfg["items"] = items
            self.cfg["cur"] = min(self.cfg["cur"], len(items) - 1)
        notes = [("Plik .git/wt.conf zmieniony.", "green")] if after != before else [("Bez zmian.", "dim")]
        notes += [(l, "yellow") for l in conf_problems(after or "")]
        self.cfg["notes"] = notes
        return after != before

    def config_apply(self, args):
        """Run `wt config set|unset ...`; show errors in the red modal, results in the screen footer."""
        rc, out, err = run([WT, "config"] + args)
        if rc != 0:
            self.modal("Błąd", clean_error(err, "wt config nie powiodło się"))
            return False
        notes = [(l, "green") for l in clean_error(out, "").splitlines()]
        notes += [(l, "yellow") for l in clean_error(err, "").splitlines()]
        items, _ = self.config_load()
        keep = self.cfg["cur"]
        if items:
            self.cfg["items"] = items
        self.cfg["cur"] = min(keep, len(self.cfg["items"]) - 1)
        self.cfg["notes"] = notes
        return True

    def loop(self):
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        while True:
            if self.pending_error:
                title, text = self.pending_error
                self.pending_error = None
                self.draw()
                self.modal(title, text)
            self.draw()
            busy = "loading" in (self.pr_status, self.fetch_status) or self.refreshing
            self.scr.timeout(250 if busy else 1000 if self.auto else -1)
            key = self.scr.getch()
            self.scr.timeout(-1)
            if key == -1:
                self.tick()
                continue
            if key == curses.KEY_RESIZE:
                continue
            rows = self.visible()
            self.cursor = max(0, min(self.cursor, len(rows) - 1))
            row = rows[self.cursor] if rows and not self.on_header else None  # no row actions on the header
            page = self.body_h
            if self.show_help and self.menu == "pr":
                self.menu_note = ""
                if key in (ord("h"), 27, curses.KEY_BACKSPACE, 127, 8):
                    self.menu = "main"
                elif key == ord(" "):
                    self.show_help = False
                    self.menu = "main"
                elif row and key in PR_KEYS:
                    blocked = self.pr_state(row).get(chr(key))
                    if blocked:  # disabled entry: stay in the menu and say why
                        self.menu_note = blocked[1]
                        continue
                    self.show_help = False
                    self.menu = "main"
                    self.act(PR_KEYS[key], row)
                continue
            if self.show_help and self.menu in ("open", "copy"):
                target = row or (self.main if self.on_header else None)
                self.menu_note = ""
                blocked = self.sub_state(target).get(chr(key)) if target and 0 < key < 256 else None
                if blocked:  # disabled entry: stay in the menu and say why
                    self.menu_note = blocked[1]
                    continue
                if key in (ord("h"), 27, curses.KEY_BACKSPACE, 127, 8):
                    self.menu = "main"
                elif key == ord(" "):
                    self.show_help = False
                    self.menu = "main"
                elif self.menu == "copy" and key in (ord("c"), ord("u")) and target:
                    self.show_help = False
                    self.menu = "main"
                    if key == ord("c"):
                        self.copy_cd({"path": target["path"]})
                    else:
                        pr = self.prs[target["branch"]]
                        self.copy_text(pr["url"], f"skopiowano URL PR #{pr['number']}: {pr['url']}")
                elif self.menu == "copy":
                    pass
                elif key == ord("c") and target:
                    self.show_help = False
                    self.menu = "main"
                    self.open_vscode({"path": target["path"]})
                elif key == ord("b") and target:
                    self.show_help = False
                    self.menu = "main"
                    self.open_pr_browser(target)
                continue
            if key == ord("g") and not self.pending_g:
                self.pending_g = True
                continue
            gg = self.pending_g and key == ord("g")
            self.pending_g = False
            if self.show_help and key in (ord(" "), 27):
                self.show_help = False
            elif key == ord(" "):
                self.show_help = True
                self.menu = "main"
            elif key == ord("p") and row:
                self.show_help = True
                self.menu = "pr"
            elif key in (ord("q"), 27):
                if self.filter and key == 27:
                    self.filter = ""
                    continue
                break
            elif key in (curses.KEY_UP, ord("k")):
                if self.on_header:
                    pass
                elif self.cursor == 0:
                    self.on_header = True  # top of the list: move focus to the header (main checkout)
                else:
                    self.cursor -= 1
            elif key in (curses.KEY_DOWN, ord("j")):
                if self.on_header:
                    self.on_header = False
                else:
                    self.cursor += 1
            elif key == curses.KEY_PPAGE:
                self.cursor -= page
                self.on_header = False
            elif key == curses.KEY_NPAGE:
                self.cursor += page
                self.on_header = False
            elif key == curses.KEY_HOME or gg:
                self.cursor = 0
                self.on_header = False
            elif key in (curses.KEY_END, ord("G")):
                self.cursor = len(rows) - 1
                self.on_header = False
            elif key == ord("r"):
                self.reload()
                self.message = "odświeżono"
            elif key == ord("R"):
                self.auto = not self.auto and self.poll > 0
                self.message = ("autoodświeżanie włączone" if self.auto else
                                "autoodświeżanie wyłączone" if self.poll > 0 else "autoodświeżanie wyłączone (WT_UI_POLL=0)")
                self.next_stat = self.next_poll = time.monotonic()
            elif key == ord("/"):
                value = self.prompt("Filtr (pusty = wyczyść)", self.filter)
                if not self.cancelled:
                    self.filter = value
                    self.cursor = 0
            elif key == ord("n"):
                self.new()
            elif key == ord("U"):
                self.pull_main()
            elif key == ord("C"):
                self.show_help = False
                self.config_screen()
            elif key == ord("t") and row:
                self.run_tests(row)
            elif key == ord("c") and (row or (self.on_header and self.main)):
                self.show_help = True
                self.menu = "copy"
            elif key == ord("o") and (row or (self.on_header and self.main)):
                self.show_help = True
                self.menu = "open"
            elif row and key in ACTION_KEYS:
                self.show_help = False
                self.act(ACTION_KEYS[key], row)


def main():
    rc, _, err = run([WT, "list", "--porcelain"])
    if rc != 0:
        sys.exit(err.strip() or "wt: nie udało się odczytać listy worktree")
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass
    os.environ.setdefault("ESCDELAY", "25")
    curses.wrapper(lambda scr: App(scr).loop())


if __name__ == "__main__":
    main()
