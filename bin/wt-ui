def display_cmd(argv, wt=None):
    """Shell-quoted command for the confirmation modal; the wt script path is shown as plain 'wt'."""
    parts = list(argv)
    if wt is not None and parts and parts[0] == wt:
        parts[0] = "wt"
    return " ".join(shlex.quote(p) for p in parts)


def merge_block(pr):
    """(refusal, warning) for merging a PR: refusal is a reason string or None."""
    if pr["state"] != "OPEN":
        return "PR #%d nie jest otwarty (%s)." % (pr["number"], pr["state"].lower() or "?"), None
    if pr["draft"]:
        return "PR #%d jest draftem. Najpierw oznacz go jako ready (Space, p, d)." % pr["number"], None
    if pr["mergeable"] == "CONFLICTING":
        return "PR #%d ma konflikty z targetem. Najpierw rozwiąż konflikty (rebase/merge targetu w worktree), potem spróbuj ponownie." % pr["number"], None
    if pr["mergeable"] != "MERGEABLE":
        return "GitHub jeszcze liczy, czy PR da się zmergować. Spróbuj za chwilę (r = odśwież).", None
    if pr["ci"] == "red":
        return "CI jest czerwone. Napraw testy przed mergem.", None
    if pr["ci"] == "yellow":
        return None, "CI jeszcze trwa - GitHub może odrzucić merge."
    return None, None


def plan_action(kind, row, meta, pr, base, pr_status, has_gh, wt="wt"):
    """Plan a single-worktree action. Pure: returns {"error": str} or {"title", "lines", "steps"}.

    kind: push | ready | merge | close | drop | mergedrop. Each step is {"argv", "cwd"}.
    Never forces anything; push and gh live only here, behind an explicit confirmation.
    """
    branch, path = row["branch"], row["path"]
    target = meta.get("target") or base
    title = meta.get("title") or branch
    drop_argv = [wt, "drop", branch]
    if kind == "drop":
        merged = bool(pr and pr["state"] == "MERGED")
        steps = [{"argv": drop_argv + (["--merged-pr"] if merged else []), "cwd": None}]
        lines = ["Usunie worktree i gałąź lokalną '%s'." % branch,
                 "Odmowa przy zmianach niezacommitowanych, niezmergowanych commitach",
                 "(chyba że PR jest zmergowany) albo żywym właścicielu."]
        return {"title": "Usuń worktree", "lines": lines, "steps": steps}

    gh_kinds = ("ready", "merge", "close", "mergedrop")
    if kind in gh_kinds or kind == "push":
        if kind in gh_kinds and not has_gh:
            return {"error": "Brak programu 'gh' w PATH. Zainstaluj GitHub CLI i zaloguj się (gh auth login)."}
        if has_gh and pr_status != "ok":
            why = ("PR jeszcze się wczytują, spróbuj za chwilę." if pr_status == "loading" else
                   "Nie udało się pobrać PR z GitHuba (offline, brak origin albo brak logowania: gh auth login).")
            return {"error": why}

    if kind == "push":
        steps = [{"argv": ["git", "push", "-u", "origin", branch], "cwd": path}]
        lines = ["Wypchnie gałąź '%s' do origin (bez force)." % branch]
        if has_gh and not (pr and pr["state"] == "OPEN"):
            if not target:
                return {"error": "Brak gałęzi docelowej (target) dla PR."}
            steps.append({"argv": ["gh", "pr", "create", "--draft", "--base", target, "--head", branch,
                                   "--title", title, "--body", ""], "cwd": path})
            lines.append("Utworzy PR (draft) '%s' -> '%s'." % (branch, target))
        elif has_gh:
            lines.append("PR #%d już istnieje - tylko push." % pr["number"])
        else:
            lines.append("Brak 'gh' - tylko push, bez PR.")
        return {"title": "Push / PR", "lines": lines, "steps": steps}

    if not pr:
        return {"error": "Ta gałąź nie ma PR. Utwórz go: Space, p, p."}
    num = str(pr["number"])
    if kind == "ready":
        if pr["state"] != "OPEN":
            return {"error": "PR #%s nie jest otwarty (%s)." % (num, pr["state"].lower() or "?")}
        argv = ["gh", "pr", "ready", num] + ([] if pr["draft"] else ["--undo"])
        what = "ready (do przeglądu)" if pr["draft"] else "draft"
        return {"title": "Status PR", "lines": ["Zmieni PR #%s na %s." % (num, what)],
                "steps": [{"argv": argv, "cwd": path}]}

    if kind == "close":
        if pr["state"] != "OPEN":
            return {"error": "PR #%s nie jest otwarty (%s)." % (num, pr["state"].lower() or "?")}
        return {"title": "Zamknij PR", "lines": ["Zamknie PR #%s bez mergowania (gałąź i worktree zostają)." % num],
                "steps": [{"argv": ["gh", "pr", "close", num], "cwd": path}]}

    refusal, warning = merge_block(pr)
    if refusal:
        return {"error": refusal}
    steps = []
    lines = []
    if kind == "mergedrop":
        steps.append({"argv": drop_argv + ["--merged-pr", "--check"], "cwd": None})
        lines.append("Najpierw sprawdzi, czy worktree da się usunąć (nic jeszcze nie usuwa).")
    steps.append({"argv": ["gh", "pr", "merge", num, "--merge"], "cwd": path})
    lines.append("Zmerguje PR #%s (merge commit, bez usuwania gałęzi zdalnej)." % num)
    if kind == "mergedrop":
        steps.append({"argv": drop_argv + ["--merged-pr"], "cwd": None})
        lines.append("Po sukcesie usunie worktree i gałąź lokalną '%s'." % branch)
    if warning:
        lines.append("UWAGA: " + warning)
    return {"title": "Merge PR + usuń" if kind == "mergedrop" else "Merge PR", "lines": lines, "steps": steps}


def pr_menu_state(row, pr, pr_status, has_gh):
    """Availability of the PR submenu keys: {key: None | (short, full)}; None = enabled.

    Pure. Mirrors plan_action's refusals so a disabled entry never opens a confirmation just to fail.
    """
    keys = ("p", "d", "m", "M", "c")
    if has_gh and pr_status != "ok":
        short = "PR się wczytują" if pr_status == "loading" else "brak połączenia z GitHub"
        full = ("PR jeszcze się wczytują, spróbuj za chwilę." if pr_status == "loading" else
                "Nie udało się pobrać PR z GitHuba (offline, brak origin albo brak logowania: gh auth login).")
        return {k: (short, full) for k in keys}
    st = {"p": None}  # push is always possible (creates a draft PR when none is open)
    if not has_gh:
        for k in keys[1:]:
            st[k] = ("brak gh", "Brak programu 'gh' w PATH. Zainstaluj GitHub CLI i zaloguj się (gh auth login).")
        return st
    if not pr:
        for k in keys[1:]:
            st[k] = ("brak PR", "Ta gałąź nie ma PR. Najpierw utwórz go (p).")
        return st
    if pr["state"] != "OPEN":
        what = (pr["state"] or "?").lower()
        for k in keys[1:]:
            st[k] = ("PR " + what, "PR #%d nie jest otwarty (%s)." % (pr["number"], what))
        return st
    st["d"] = st["c"] = None
    refusal, _ = merge_block(pr)
    if refusal:
        if pr["draft"]:
            short = "najpierw ready (d)"
        elif pr["mergeable"] == "CONFLICTING":
            short = "najpierw rozwiąż konflikty"
        elif pr["mergeable"] != "MERGEABLE":
            short = "GitHub liczy mergeable"
        else:
            short = "CI czerwone"
        st["m"] = st["M"] = (short, refusal)
    else:
        st["m"] = None
        dirty = (row.get("dirty") or "0").strip()
        if dirty not in ("", "0", "-"):
            st["M"] = ("zmiany niezacommitowane",
                       "Worktree ma niezacommitowane zmiany (%s), więc nie da się go usunąć. Zacommituj je albo użyj samego merge (m)." % dirty)
        else:
            st["M"] = None
    return st


# key -> action kind (see plan_action)
ACTION_KEYS = {ord("x"): "drop"}  # direct keys on the focused worktree
def commit_mark(sha, local):
    """(glyph, style) for a commit: ↑ local-only, ✓ on origin, · when unknown (git failed). Pure.

    local is the set of abbreviated SHAs not on any origin ref; abbreviations may differ in
    length between git calls, so match by prefix in both directions.
    """
    if local is None:
        return ("·", "dim")
    if any(sha.startswith(l) or l.startswith(sha) for l in local):
        return ("↑", "accent")
    return ("✓", "green")


def open_menu_state(row, pr, pr_status, has_gh):
    """Availability of the Open submenu keys: {key: None | (short, full)}; None = enabled. Pure."""
    # tmux: placeholder until `wt new` creates a tmux session per worktree.
    return {"c": None, "b": pr_url_block(row, pr, pr_status, has_gh),
            "t": ("wkrótce", "Otwieranie w tmux jeszcze nie działa: wt new nie tworzy jeszcze sesji tmux dla worktree.")}


def copy_menu_state(row, pr, pr_status, has_gh):
    """Availability of the Copy submenu keys: {key: None | (short, full)}; None = enabled. Pure."""
    return {"c": None, "u": pr_url_block(row, pr, pr_status, has_gh)}


def pr_url_block(row, pr, pr_status, has_gh):
    """None when the row's PR URL is known, else (short, full) saying why it is not. Pure."""
    if not row or not row.get("branch"):
        return ("brak gałęzi", "Ten wiersz nie ma gałęzi, więc nie ma też PR.")
    if not has_gh:
        return ("brak gh", "Brak programu 'gh' w PATH. Zainstaluj GitHub CLI i zaloguj się (gh auth login).")
    if pr_status != "ok":
        return (("PR się wczytują", "PR jeszcze się wczytują, spróbuj za chwilę.") if pr_status == "loading" else
                ("brak połączenia z GitHub", "Nie udało się pobrać PR z GitHuba (offline, brak origin albo brak logowania: gh auth login)."))
    if not pr or not pr.get("url"):
        return ("brak PR", "Ta gałąź nie ma PR. Najpierw utwórz go (Space, p, p).")
    return None


