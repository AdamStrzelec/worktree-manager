#!/usr/bin/env bash
# wt - git worktree manager. Isolates parallel work; returns to base via `wt merge`.
# Compatible with bash 3.2 (macOS default): no mapfile, no assoc arrays, no ${var,,}.
# DEFAULT_* and SRC_* are read indirectly via eval on fixed key names (load_config, cmd_config).
# shellcheck disable=SC2034
set -uo pipefail

# ---------------------------------------------------------------- output ----

# Errors are red on a terminal; NO_COLOR disables, WT_COLOR=always forces (used by tests).
die() {
  if [ -z "${NO_COLOR:-}" ] && { [ -t 2 ] || [ "${WT_COLOR:-}" = always ]; }; then
    printf '\033[31mwt: %s\033[0m\n' "$*" >&2
  else
    printf 'wt: %s\n' "$*" >&2
  fi
  exit 1
}

info() {
  printf '%s\n' "$*"
}

# --------------------------------------------------------------- config -----

# Keys a repo-tracked .wt.conf may set. Everything else needs a trusted source
# (.git/wt.conf, global config, env) because WT_TEST / WT_POST_NEW run commands.
SAFE_KEYS=" WT_DIR WT_BASE WT_LINK WT_COPY WT_FETCH "
ALL_KEYS="WT_DIR WT_BASE WT_LINK WT_COPY WT_FETCH WT_TEST WT_POST_NEW WT_PRE_DROP WT_POST_DROP"

# Seconds before a hung `git fetch` (network, auth prompt) is abandoned; env override for tests.
FETCH_TIMEOUT=${WT_FETCH_TIMEOUT:-20}
case "$FETCH_TIMEOUT" in ''|*[!0-9]*) FETCH_TIMEOUT=20 ;; esac

# Built-in defaults.
DEFAULT_WT_DIR=".claude/worktrees"
DEFAULT_WT_BASE=""
DEFAULT_WT_LINK=".env .venv"
DEFAULT_WT_COPY=""
DEFAULT_WT_FETCH="1"
DEFAULT_WT_TEST=""
DEFAULT_WT_POST_NEW=""
DEFAULT_WT_PRE_DROP=""
DEFAULT_WT_POST_DROP=""

# Effective values and their origin, filled by load_config.
CFG_WT_DIR="" CFG_WT_BASE="" CFG_WT_LINK="" CFG_WT_COPY="" CFG_WT_FETCH="" CFG_WT_TEST="" CFG_WT_POST_NEW="" CFG_WT_PRE_DROP="" CFG_WT_POST_DROP=""
SRC_WT_DIR="" SRC_WT_BASE="" SRC_WT_LINK="" SRC_WT_COPY="" SRC_WT_FETCH="" SRC_WT_TEST="" SRC_WT_POST_NEW="" SRC_WT_PRE_DROP="" SRC_WT_POST_DROP=""

# set_cfg KEY VALUE SOURCE - assign without eval (value stays plain text).
set_cfg() {
  case "$1" in
    WT_DIR)      CFG_WT_DIR=$2;      SRC_WT_DIR=$3 ;;
    WT_BASE)     CFG_WT_BASE=$2;     SRC_WT_BASE=$3 ;;
    WT_LINK)     CFG_WT_LINK=$2;     SRC_WT_LINK=$3 ;;
    WT_COPY)     CFG_WT_COPY=$2;     SRC_WT_COPY=$3 ;;
    WT_FETCH)    CFG_WT_FETCH=$2;    SRC_WT_FETCH=$3 ;;
    WT_TEST)     CFG_WT_TEST=$2;     SRC_WT_TEST=$3 ;;
    WT_POST_NEW) CFG_WT_POST_NEW=$2; SRC_WT_POST_NEW=$3 ;;
    WT_PRE_DROP) CFG_WT_PRE_DROP=$2; SRC_WT_PRE_DROP=$3 ;;
    WT_POST_DROP) CFG_WT_POST_DROP=$2; SRC_WT_POST_DROP=$3 ;;
  esac
}

# parse_conf FILE SOURCE TRUSTED(1|0) - read KEY=value lines, never source the file.
parse_conf() {
  local file=$1 source_name=$2 trusted=$3 line key val
  [ -f "$file" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    case "$line" in *=*) ;; *) continue ;; esac
    key=${line%%=*}
    val=${line#*=}
    key=${key//[[:space:]]/}
    # Strip one pair of surrounding quotes.
    case "$val" in
      \"*\") val=${val#\"}; val=${val%\"} ;;
      \'*\') val=${val#\'}; val=${val%\'} ;;
    esac
    case " $ALL_KEYS " in *" $key "*) ;; *) continue ;; esac
    if [ "$trusted" != 1 ]; then
      case "$SAFE_KEYS" in *" $key "*) ;; *)
        info "wt: pomijam $key w $file (niezaufane źródło)" >&2
        continue ;;
      esac
    fi
    set_cfg "$key" "$val" "$source_name"
  done < "$file"
}

# load_config - precedence: env > .git/wt.conf > .wt.conf > global > default.
load_config() {
  local key def env_val
  for key in $ALL_KEYS; do
    eval "def=\$DEFAULT_$key"
    set_cfg "$key" "$def" "domyślna"
  done
  parse_conf "${XDG_CONFIG_HOME:-$HOME/.config}/wt/config" "global" 1
  if [ -n "${MAIN:-}" ]; then
    parse_conf "$MAIN/.wt.conf" "repo (.wt.conf)" 0
    parse_conf "$MAIN/.git/wt.conf" "repo (.git/wt.conf)" 1
  fi
  for key in $ALL_KEYS; do
    # Indirect read of an env var by name; only fixed keys from ALL_KEYS reach here.
    env_val=${!key-}
    if [ -n "$env_val" ]; then
      set_cfg "$key" "$env_val" "env"
    fi
  done
}

# ------------------------------------------------------------ repo / git ----

MAIN=""
BASE=""
WT_ROOT=""

# repo_main - set MAIN to the main checkout, also when called from a worktree.
repo_main() {
  local common
  git rev-parse --git-dir >/dev/null 2>&1 || die "nie jesteś w repo git"
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
    || common=$(cd "$(git rev-parse --git-common-dir)" && pwd -P)
  [ "$(git -C "$common" rev-parse --is-bare-repository 2>/dev/null)" = true ] \
    && die "repo bare nie jest obsługiwane"
  MAIN=${common%/.git}
  [ -d "$MAIN" ] || die "nie znaleziono głównego checkoutu: $MAIN"
}

# base_branch - WT_BASE, else main, else master, else current branch of MAIN.
base_branch() {
  local b
  if [ -n "$CFG_WT_BASE" ]; then
    git -C "$MAIN" rev-parse --verify --quiet "refs/heads/$CFG_WT_BASE" >/dev/null \
      || die "gałąź bazowa '$CFG_WT_BASE' (WT_BASE) nie istnieje"
    BASE=$CFG_WT_BASE
    return 0
  fi
  for b in main master; do
    if git -C "$MAIN" rev-parse --verify --quiet "refs/heads/$b" >/dev/null; then
      BASE=$b
      return 0
    fi
  done
  b=$(git -C "$MAIN" symbolic-ref --quiet --short HEAD 2>/dev/null) \
    || die "brak gałęzi bazowej (repo bez commitów albo detached HEAD)"
  BASE=$b
}

# wt_dir_abs DIR - DIR relative to MAIN (or absolute), normalized.
wt_dir_abs() {
  case "$1" in
    /*) norm_path "$1" ;;
    *)  norm_path "$MAIN/$1" ;;
  esac
}

# resolve_wt_root - WT_ROOT from the effective WT_DIR.
resolve_wt_root() {
  WT_ROOT=$(wt_dir_abs "$CFG_WT_DIR")
}

# norm_path ABS - lexical normalization (collapse ., .., //); path need not exist.
norm_path() {
  local IFS=/ part out=""
  set -f
  for part in $1; do
    case "$part" in
      ''|.) ;;
      ..)   out=${out%/*} ;;
      *)    out="$out/$part" ;;
    esac
  done
  set +f
  printf '%s' "${out:-/}"
}

# valid_name NAME - dies unless NAME is a safe branch/dir name.
valid_name() {
  local name=$1
  printf '%s' "$name" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._/-]*$' \
    || die "zła nazwa '$name' (dozwolone: litery, cyfry, . _ / -)"
  case "$name" in
    *..*|*//*|*/|*.lock) die "zła nazwa '$name' (.., //, końcowy / lub .lock)" ;;
  esac
  git check-ref-format --branch "$name" >/dev/null 2>&1 \
    || die "'$name' nie jest poprawną nazwą gałęzi"
}

# tracked_clean DIR - true when DIR has no staged/unstaged changes in tracked files.
tracked_clean() {
  git -C "$1" diff --quiet && git -C "$1" diff --cached --quiet
}

# json_escape STR - escape backslash and double quote.
json_escape() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  printf '%s' "$s"
}

# add_exclude LINE - append LINE to the shared info/exclude once (mkdir lock, no flock on macOS).
add_exclude() {
  local line=$1 common file lock tries=0
  common=$(git -C "$MAIN" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
    || common="$MAIN/.git"
  file="$common/info/exclude"
  lock="$common/wt.lock"
  while ! mkdir "$lock" 2>/dev/null; do
    tries=$((tries + 1))
    [ "$tries" -gt 50 ] && die "nie mogę zdobyć blokady $lock (usuń ją, jeśli to pozostałość)"
    sleep 0.1
  done
  mkdir -p "$common/info"
  touch "$file"
  grep -qxF -- "$line" "$file" || printf '%s\n' "$line" >> "$file"
  rmdir "$lock"
}

# owner_field FILE KEY - read a field from .wt-owner (flat JSON written by wt itself).
owner_field() {
  sed -n "s/.*\"$2\":\"\{0,1\}\([^\",}]*\)\"\{0,1\}.*/\1/p" "$1" 2>/dev/null | head -1
}

# init_repo - common start for every command that needs a repo.
init_repo() {
  repo_main
  load_config
  base_branch
  resolve_wt_root
}

# ------------------------------------------------------------- commands -----

usage() {
  local repo=""
  if git rev-parse --git-dir >/dev/null 2>&1; then
    repo=$(repo_main_quiet)
  fi
  {
    printf 'Użycie: wt <komenda> [argumenty]\n\n'
    printf '  new <temat> [--no-fetch] nowy worktree i gałąź od (zaktualizowanej) bazy\n'
    printf '  list | ls               tabela worktree\n'
    printf '  status                  kolizje plików między worktree\n'
    printf '  test [args]             testy w bieżącym worktree\n'
    printf '  merge <temat>           testy, rebase, testy, merge --ff-only\n'
    printf '  drop <temat>            usuń worktree i gałąź (tylko gdy bezpieczne)\n'
    printf '  ui                      interfejs w terminalu (curses)\n'
    printf '  config [set|unset|--porcelain] konfiguracja i jej źródła\n\n'
    printf 'Repo: %s\n' "${repo:-(poza repo git)}"
  } >&2
  exit 1
}

# repo_main_quiet - print main checkout path without dying (for usage).
repo_main_quiet() {
  local common
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
    || common=$(cd "$(git rev-parse --git-common-dir)" 2>/dev/null && pwd -P)
  printf '%s' "${common%/.git}"
}

# cfg_known_key KEY - dies unless KEY is a configurable key.
cfg_known_key() {
  case " $ALL_KEYS " in
    *" $1 "*) ;;
    *) die "nieznany klucz: $1 (dostępne: $ALL_KEYS)" ;;
  esac
}

# cfg_validate KEY VALUE - dies when VALUE is unusable for KEY (needs MAIN and loaded config).
cfg_validate() {
  local key=$1 val=$2 f root probe wpath line
  case "$val" in
    *$'\n'*|*$'\r'*) die "wartość nie może zawierać nowej linii" ;;
  esac
  case "$key" in
    WT_BASE)
      [ -z "$val" ] || git -C "$MAIN" rev-parse --verify --quiet "refs/heads/$val" >/dev/null \
        || die "gałąź '$val' nie istnieje" ;;
    WT_FETCH)
      case "$val" in 0|1) ;; *) die "WT_FETCH przyjmuje 0 albo 1" ;; esac ;;
    WT_LINK|WT_COPY)
      for f in $val; do
        case "$f" in
          /*|..|../*|*/..|*/../*) die "$key: '$f' musi być ścieżką względną bez .." ;;
        esac
      done ;;
    WT_DIR)
      [ -n "$val" ] || die "WT_DIR nie może być puste (przywróć domyślną: wt config unset WT_DIR)"
      case "$val" in "~"*) die "WT_DIR: '~' nie jest rozwijane, podaj ścieżkę absolutną" ;; esac
      root=$(wt_dir_abs "$val")
      [ "$root" != / ] || die "WT_DIR nie może być katalogiem głównym /"
      case "$MAIN/" in "$root"/*) die "WT_DIR ($root) nie może być głównym checkoutem ani jego katalogiem nadrzędnym" ;; esac
      case "$root/" in "$MAIN/.git/"*) die "WT_DIR ($root) nie może leżeć w .git" ;; esac
      while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
          "worktree "*)
            wpath=${line#worktree }
            [ "$wpath" = "$MAIN" ] && continue
            case "$root/" in "$wpath/"*) die "WT_DIR ($root) leży wewnątrz worktree $wpath" ;; esac ;;
        esac
      done < <(git -C "$MAIN" worktree list --porcelain)
      [ ! -e "$root" ] || [ -d "$root" ] || die "WT_DIR ($root) istnieje i nie jest katalogiem"
      probe=$root
      while [ ! -e "$probe" ] && [ "$probe" != / ]; do
        probe=${probe%/*}
        [ -n "$probe" ] || probe=/
      done
      [ -d "$probe" ] && [ -w "$probe" ] || die "WT_DIR: nie można utworzyć $root (brak zapisu w $probe)" ;;
  esac
}

# cfg_quote VALUE - parse_conf strips one pair of surrounding quotes, so a value that
# itself starts and ends with a quote is wrapped in the other kind to survive the round trip.
cfg_quote() {
  case "$1" in
    \"*\") printf "'%s'" "$1" ;;
    \'*\') printf '"%s"' "$1" ;;
    *)     printf '%s' "$1" ;;
  esac
}

# cfg_rewrite MODE KEY [LINE] - rewrite .git/wt.conf atomically (tmp + mv). MODE=set replaces the
# first KEY line (dropping repeats) or appends LINE; MODE=unset drops every KEY line.
# Comments and other lines are kept as they are. Sets CFG_CHANGED=1|0.
cfg_rewrite() {
  local mode=$1 key=$2 newline=${3-} file="$MAIN/.git/wt.conf" tmp line k written=0
  tmp=$(mktemp "$MAIN/.git/wt.conf.XXXXXX") || die "nie mogę utworzyć pliku tymczasowego w $MAIN/.git"
  if [ -f "$file" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      k=""
      case "$line" in
        ''|'#'*) ;;
        *=*) k=${line%%=*}; k=${k//[[:space:]]/} ;;
      esac
      if [ "$k" = "$key" ]; then
        if [ "$mode" = set ] && [ "$written" = 0 ]; then
          printf '%s\n' "$newline" >> "$tmp"
          written=1
        fi
        continue
      fi
      printf '%s\n' "$line" >> "$tmp"
    done < "$file"
  fi
  if [ "$mode" = set ] && [ "$written" = 0 ]; then
    printf '%s\n' "$newline" >> "$tmp"
  fi
  if { [ -f "$file" ] && cmp -s "$tmp" "$file"; } || { [ "$mode" = unset ] && [ ! -f "$file" ]; }; then
    rm -f "$tmp"
    CFG_CHANGED=0
    return 0
  fi
  mv -f "$tmp" "$file" || { rm -f "$tmp"; die "nie mogę zapisać $file"; }
  CFG_CHANGED=1
}

# cfg_other_worktrees - number of linked worktrees (without the main checkout).
cfg_other_worktrees() {
  local n
  n=$(git -C "$MAIN" worktree list --porcelain | grep -c '^worktree ')
  printf '%s' $((n - 1))
}

# cfg_movable OLD_ROOT - paths of linked worktrees that live directly under OLD_ROOT.
cfg_movable() {
  local line wpath="" first=1
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "worktree "*) wpath=${line#worktree } ;;
      "")
        if [ -n "$wpath" ]; then
          if [ "$first" = 1 ]; then first=0; else
            case "$wpath/" in "$1"/*) printf '%s\n' "$wpath" ;; esac
          fi
        fi
        wpath="" ;;
    esac
  done < <(git -C "$MAIN" worktree list --porcelain; echo)
}

# cfg_move_check OLD NEW - refuse (before anything is written) when a move could hurt a worktree.
cfg_move_check() {
  local old=$1 new=$2 wpath rel pid
  while IFS= read -r wpath; do
    [ -n "$wpath" ] || continue
    rel=${wpath#"$old"/}
    [ ! -e "$new/$rel" ] || die "--move: cel już istnieje: $new/$rel"
    if [ -f "$wpath/.wt-owner" ]; then
      pid=$(owner_field "$wpath/.wt-owner" pid)
      if [ -n "$pid" ] && [ "$pid" != "$PPID" ] && kill -0 "$pid" 2>/dev/null; then
        die "--move: worktree '$rel' jest zajęty (pid $pid), zakończ tę sesję"
      fi
    fi
    case "$(git -C "$MAIN" worktree list --porcelain | grep -A5 -F "worktree $wpath" | grep -c '^locked')" in
      0) ;; *) die "--move: worktree '$rel' jest zablokowany (git worktree lock)" ;;
    esac
  done < <(cfg_movable "$old")
}

# cfg_move_all OLD NEW - git worktree move for every movable worktree; keeps going, reports failures.
cfg_move_all() {
  local old=$1 new=$2 wpath rel moved=0 failed=0
  while IFS= read -r wpath; do
    [ -n "$wpath" ] || continue
    rel=${wpath#"$old"/}
    mkdir -p "$(dirname "$new/$rel")"
    if git -C "$MAIN" worktree move "$wpath" "$new/$rel" 2>/dev/null; then
      info "przeniesiono: $rel"
      moved=$((moved + 1))
    else
      info "UWAGA: nie udało się przenieść: $rel (zostaje w $wpath)" >&2
      failed=$((failed + 1))
    fi
  done < <(cfg_movable "$old")
  rmdir "$old" 2>/dev/null
  case "$new" in "$MAIN"/*) add_exclude "${new#"$MAIN"}/" ;; esac
  info "przeniesiono $moved worktree, błędów: $failed"
  [ "$failed" -eq 0 ]
}

# cfg_set_cmd KEY VALUE [--move] - wt config set: write to the private .git/wt.conf only.
# --move (WT_DIR only): also move existing worktrees from the old directory to the new one.
cfg_set_cmd() {
  local move=0
  if [ $# -eq 3 ] && [ "$3" = "--move" ]; then move=1; set -- "$1" "$2"; fi
  [ $# -eq 2 ] || die "użycie: wt config set KLUCZ WARTOSC [--move] (pustą wartość podaj jako \"\"; --move tylko dla WT_DIR)"
  local key=$1 val=$2 eff src old_root="" others new_root=""
  cfg_known_key "$key"
  [ "$move" = 0 ] || [ "$key" = WT_DIR ] || die "--move działa tylko z WT_DIR"
  repo_main
  load_config
  cfg_validate "$key" "$val"
  if [ "$key" = WT_DIR ]; then
    resolve_wt_root; old_root=$WT_ROOT
    if [ "$move" = 1 ]; then
      new_root=$(wt_dir_abs "$val")
      [ "$new_root" != "$old_root" ] && cfg_move_check "$old_root" "$new_root"
    fi
  fi
  cfg_rewrite set "$key" "$key=$(cfg_quote "$val")"
  if [ "$CFG_CHANGED" = 1 ]; then
    info "ustawiono $key w .git/wt.conf"
  else
    info "bez zmian: $key już ma tę wartość w .git/wt.conf"
  fi
  load_config
  eval "src=\$SRC_$key"
  eval "eff=\$CFG_$key"
  if [ "$src" != "repo (.git/wt.conf)" ]; then
    info "uwaga: $key jest nadal przesłonięte przez: $src (wartość: ${eff:-(puste)})" >&2
  fi
  if [ "$key" = WT_DIR ] && [ "$CFG_CHANGED" = 1 ]; then
    resolve_wt_root
    others=$(cfg_other_worktrees)
    if [ "$move" = 1 ] && [ "$WT_ROOT" != "$old_root" ]; then
      cfg_move_all "$old_root" "$WT_ROOT" || return 1
    elif [ "$WT_ROOT" != "$old_root" ] && [ "$others" -gt 0 ]; then
      info "uwaga: istniejące worktree ($others) zostają w starym miejscu ($old_root); nowe powstaną w $WT_ROOT (przenieść: wt config set WT_DIR <ścieżka> --move)" >&2
    fi
  fi
}

# cfg_unset_cmd KEY - wt config unset: drop KEY from .git/wt.conf (back to the next source).
cfg_unset_cmd() {
  [ $# -eq 1 ] || die "użycie: wt config unset KLUCZ"
  local key=$1 eff src
  cfg_known_key "$key"
  repo_main
  cfg_rewrite unset "$key"
  if [ "$CFG_CHANGED" = 1 ]; then
    info "usunięto $key z .git/wt.conf"
  else
    info "brak $key w .git/wt.conf, nic do usunięcia"
  fi
  load_config
  eval "src=\$SRC_$key"
  eval "eff=\$CFG_$key"
  info "obecnie: $key=${eff:-(puste)} (źródło: $src)"
}

cmd_config() {
  local key val src def porcelain=0
  case "${1:-}" in
    set)   shift; cfg_set_cmd "$@"; return ;;
    unset) shift; cfg_unset_cmd "$@"; return ;;
    --porcelain) porcelain=1 ;;
    "") ;;
    *) die "nieznana opcja: $1 (użycie: wt config [--porcelain | set KLUCZ WARTOSC | unset KLUCZ])" ;;
  esac
  # Not init_repo: a wrong WT_BASE must not stop the command you need to fix it with.
  repo_main
  load_config
  BASE=$(base_branch 2>/dev/null && printf '%s' "$BASE")
  [ -n "$BASE" ] || BASE="(nieprawidłowa: $CFG_WT_BASE)"
  resolve_wt_root
  if [ "$porcelain" = 1 ]; then
    # key<TAB>source<TAB>value<TAB>default; tabs inside values become spaces to keep TSV intact.
    for key in $ALL_KEYS; do
      eval "val=\$CFG_$key"
      eval "src=\$SRC_$key"
      eval "def=\$DEFAULT_$key"
      printf '%s\t%s\t%s\t%s\n' "$key" "$src" "${val//$'\t'/ }" "${def//$'\t'/ }"
    done
    return 0
  fi
  info "repo:  $MAIN"
  info "baza:  $BASE"
  info "wt:    $WT_ROOT"
  info ""
  printf '%-12s %-24s %s\n' KLUCZ ZRODLO WARTOSC
  for key in $ALL_KEYS; do
    eval "val=\$CFG_$key"
    eval "src=\$SRC_$key"
    printf '%-12s %-24s %s\n' "$key" "$src" "${val:-(puste)}"
  done
}

not_implemented() {
  die "komenda '$1' jeszcze niezaimplementowana"
}

# run_limited SECONDS CMD... - run CMD with a time limit (macOS has no timeout(1)).
# CMD runs in its own process group; on timeout the whole group is killed, so a hung ssh child
# can neither outlive the limit nor prompt on the tty. Without perl the command runs unlimited.
run_limited() {
  local secs=$1
  shift
  if command -v perl >/dev/null 2>&1; then
    PERL_BADLANG=0 perl -e '
      my $s = shift @ARGV;
      setpgrp(0, 0);
      my $pid = fork();
      if (!defined $pid) { exit 127 }
      if (!$pid) { exec @ARGV or exit 127 }
      $SIG{ALRM} = sub { kill "TERM", -$$; exit 124 };
      alarm $s;
      waitpid($pid, 0);
      exit($? >> 8);
    ' "$secs" "$@"
  else
    "$@"
  fi
}

# sync_base - fetch BASE's upstream and fast-forward the local BASE when it is only behind.
# Never fatal: every failure degrades to "use the local base" with a message.
sync_base() {
  local remote merge_ref rbranch up_ref up_sha local_sha cur n err errf
  remote=$(git -C "$MAIN" config --get "branch.$BASE.remote" 2>/dev/null) || remote=""
  merge_ref=$(git -C "$MAIN" config --get "branch.$BASE.merge" 2>/dev/null) || merge_ref=""
  if [ -z "$remote" ] || [ "$remote" = "." ] || [ -z "$merge_ref" ]; then
    info "brak upstreamu dla $BASE, używam lokalnej bazy"
    return 0
  fi
  rbranch=${merge_ref#refs/heads/}

  # stderr goes to a file, not a pipe: a straggling child holding a pipe would block $(...).
  errf=$(mktemp) || errf=/dev/null
  if ! run_limited "$FETCH_TIMEOUT" env GIT_TERMINAL_PROMPT=0 \
      git -C "$MAIN" fetch --quiet "$remote" "$rbranch" >/dev/null 2>"$errf"; then
    info "UWAGA: fetch z '$remote' nie powiódł się (brak sieci/dostępu albo limit ${FETCH_TIMEOUT}s), używam lokalnej bazy" >&2
    [ -s "$errf" ] && printf '  %s\n' "$(head -1 "$errf")" >&2
    [ "$errf" != /dev/null ] && rm -f "$errf"
    return 0
  fi
  [ "$errf" != /dev/null ] && rm -f "$errf"

  up_sha=$(git -C "$MAIN" rev-parse --verify --quiet "$BASE@{upstream}") || up_sha=""
  up_ref=$(git -C "$MAIN" rev-parse --symbolic-full-name "$BASE@{upstream}" 2>/dev/null) || up_ref=""
  if [ -z "$up_sha" ] || [ -z "$up_ref" ]; then
    info "UWAGA: po fetch nie znaleziono $remote/$rbranch, używam lokalnej bazy" >&2
    return 0
  fi
  local_sha=$(git -C "$MAIN" rev-parse "$BASE")
  [ "$local_sha" = "$up_sha" ] && return 0

  if git -C "$MAIN" merge-base --is-ancestor "$local_sha" "$up_sha"; then
    n=$(git -C "$MAIN" rev-list --count "$local_sha..$up_sha")
    cur=$(git -C "$MAIN" symbolic-ref --quiet --short HEAD 2>/dev/null) || cur=""
    if [ "$cur" = "$BASE" ]; then
      err=$(git -C "$MAIN" merge --ff-only --quiet "$up_sha" 2>&1)
    else
      # Not checked out in the main checkout: move the ref only (ff-only by default, no "+").
      err=$(git -C "$MAIN" fetch --quiet . "$up_ref:refs/heads/$BASE" 2>&1)
    fi
    # shellcheck disable=SC2181
    if [ $? -eq 0 ]; then
      info "baza $BASE zaktualizowana o $n commit(ów) z $remote/$rbranch"
    else
      info "UWAGA: nie udało się przewinąć $BASE do $remote/$rbranch, używam lokalnej bazy" >&2
      [ -n "$err" ] && printf '  %s\n' "$(printf '%s' "$err" | head -1)" >&2
    fi
  elif git -C "$MAIN" merge-base --is-ancestor "$up_sha" "$local_sha"; then
    n=$(git -C "$MAIN" rev-list --count "$up_sha..$local_sha")
    info "baza $BASE jest $n commit(ów) przed $remote/$rbranch (niewypchnięte), używam lokalnej"
  else
    info "UWAGA: $BASE i $remote/$rbranch rozjechały się, używam lokalnej bazy bez zmian" >&2
  fi
  return 0
}

cmd_new() {
  local name="" path f post_rc=0 rel hash do_fetch=1 target="" title=""
  local usage="użycie: wt new <temat> [--target <gałąź>] [--title <tytuł>] [--no-fetch]"
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-fetch) do_fetch=0 ;;
      --target)   [ $# -ge 2 ] || die "$usage"; target=$2; shift ;;
      --title)    [ $# -ge 2 ] || die "$usage"; title=$2; shift ;;
      -*)         die "nieznana opcja: $1" ;;
      *)
        [ -n "$name" ] && die "$usage"
        name=$1 ;;
    esac
    shift
  done
  [ -n "$name" ] || die "$usage"
  init_repo
  if [ -n "$target" ]; then
    git -C "$MAIN" rev-parse --verify --quiet "refs/heads/$target" >/dev/null \
      || die "gałąź docelowa '$target' nie istnieje"
    BASE=$target
  fi
  title=$(printf '%s' "$title" | tr '\t\n\r' '   ')
  valid_name "$name"
  path="$WT_ROOT/$name"
  [ -e "$path" ] && die "ścieżka już istnieje: $path"
  git -C "$MAIN" rev-parse --verify --quiet "refs/heads/$name" >/dev/null \
    && die "gałąź '$name' już istnieje"
  if ! tracked_clean "$MAIN"; then
    git -C "$MAIN" status --short >&2
    die "baza ma niezacommitowane zmiany w plikach trackowanych"
  fi

  if [ "$do_fetch" = 1 ] && [ "$CFG_WT_FETCH" != 0 ]; then
    sync_base
  fi

  git -C "$MAIN" worktree add -q -b "$name" "$path" "$BASE" || die "git worktree add nie powiodło się"
  # Per-branch metadata (git removes it together with the branch).
  git -C "$MAIN" config "branch.$name.wt-target" "$BASE"
  if [ -n "$title" ]; then git -C "$MAIN" config "branch.$name.wt-title" "$title"; fi

  for f in $CFG_WT_LINK; do
    if [ -e "$MAIN/$f" ] || [ -L "$MAIN/$f" ]; then
      if [ -e "$path/$f" ] || [ -L "$path/$f" ]; then
        info "pomijam link $f (już istnieje w worktree)"
      else
        mkdir -p "$(dirname "$path/$f")"
        ln -s "$MAIN/$f" "$path/$f"
        # A symlink is not matched by dir-only ignore patterns (e.g. "node_modules/").
        add_exclude "/$f"
      fi
    fi
  done

  for f in $CFG_WT_COPY; do
    if [ -e "$MAIN/$f" ]; then
      if [ -e "$path/$f" ] || [ -L "$path/$f" ]; then
        info "pomijam kopię $f (już istnieje w worktree)"
      else
        mkdir -p "$(dirname "$path/$f")"
        cp -R "$MAIN/$f" "$path/$f"
        add_exclude "/$f"
      fi
    fi
  done

  printf '{"session":"%s","pid":%s,"pane":"%s","time":"%s","user":"%s"}\n' \
    "$(json_escape "${CLAUDE_SESSION_ID:-}")" "$PPID" "$(json_escape "${TMUX_PANE:-}")" \
    "$(date +%Y-%m-%dT%H:%M:%S%z)" "$(json_escape "${USER:-$(id -un)}")" > "$path/.wt-owner"

  add_exclude ".wt-owner"
  case "$WT_ROOT" in
    "$MAIN"/*) rel=${WT_ROOT#"$MAIN"}; add_exclude "$rel/" ;;
  esac

  if [ -n "$CFG_WT_POST_NEW" ]; then
    info "uruchamiam WT_POST_NEW: $CFG_WT_POST_NEW"
    (cd "$path" && bash -c "$CFG_WT_POST_NEW") || post_rc=$?
    [ "$post_rc" -ne 0 ] && info "UWAGA: WT_POST_NEW zakończyło się kodem $post_rc (worktree zostaje)" >&2
  fi

  hash=$(git -C "$MAIN" rev-parse --short "$BASE")
  info "gałąź: $name (od $BASE @ $hash)"
  info "cd $path"
  return "$post_rc"
}

cmd_list() {
  local porcelain=0
  case "${1:-}" in
    --porcelain) porcelain=1 ;;
    "") ;;
    *) die "nieznana opcja: $1 (użycie: wt list [--porcelain])" ;;
  esac
  init_repo
  local line wpath="" branch="" first=1 rows="" width=6
  # Collect "path<TAB>branch" for every worktree except the main checkout.
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "worktree "*) wpath=${line#worktree }; branch="(detached)" ;;
      "branch "*)   branch=${line#branch refs/heads/} ;;
      "")
        if [ -n "$wpath" ]; then
          if [ "$first" = 1 ]; then first=0; else
            rows="$rows$wpath	$branch
"
            [ "${#branch}" -gt "$width" ] && width=${#branch}
          fi
        fi
        wpath="" ;;
    esac
  done < <(git -C "$MAIN" worktree list --porcelain; echo)

  if [ -z "$rows" ]; then
    [ "$porcelain" = 1 ] || info "brak worktree"
    return 0
  fi

  [ "$porcelain" = 1 ] || printf "%-${width}s  %-16s  %-5s  %-6s  %s\n" GALAZ WIEK AHEAD BRUDNE WLASCICIEL
  local p b age ahead dirty owner pid pane
  while IFS='	' read -r p b; do
    [ -n "$p" ] || continue
    age=$(git -C "$p" log -1 --format=%cr 2>/dev/null || echo "?")
    ahead=$(git -C "$MAIN" rev-list --count "$BASE..$b" 2>/dev/null || echo "?")
    dirty=$(git -C "$p" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    owner="wolny"
    if [ -f "$p/.wt-owner" ]; then
      pid=$(owner_field "$p/.wt-owner" pid)
      pane=$(owner_field "$p/.wt-owner" pane)
      if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        owner="zajęty (pid $pid${pane:+, $pane})"
      fi
    fi
    if [ "$porcelain" = 1 ]; then
      # Machine-readable: path, branch, age, ahead, dirty, owner (tab-separated).
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$p" "$b" "$age" "$ahead" "$dirty" "$owner"
    else
      printf "%-${width}s  %-16s  %-5s  %-6s  %s\n" "$b" "$age" "$ahead" "$dirty" "$owner"
    fi
  done <<EOF
$rows
EOF
}

# changed_files DIR OUTFILE - sorted unique files touched in worktree DIR:
# committed since merge-base with BASE + uncommitted vs HEAD + untracked (not ignored).
changed_files() {
  local dir=$1 out=$2 mb
  mb=$(git -C "$dir" merge-base "$BASE" HEAD 2>/dev/null) || mb=""
  {
    [ -n "$mb" ] && git -C "$dir" -c core.quotepath=off diff --name-only "$mb" HEAD
    git -C "$dir" -c core.quotepath=off diff --name-only HEAD
    git -C "$dir" -c core.quotepath=off ls-files --others --exclude-standard
  } 2>/dev/null | LC_ALL=C sort -u > "$out"
}

cmd_status() {
  init_repo
  local line wpath="" branch="" first=1 n=0 i j tmp collisions=0 common
  local paths=() branches=()

  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "worktree "*) wpath=${line#worktree }; branch="(detached)" ;;
      "branch "*)   branch=${line#branch refs/heads/} ;;
      "")
        if [ -n "$wpath" ]; then
          if [ "$first" = 1 ]; then first=0; else
            paths[n]=$wpath
            branches[n]=$branch
            n=$((n + 1))
          fi
        fi
        wpath="" ;;
    esac
  done < <(git -C "$MAIN" worktree list --porcelain; echo)

  if [ "$n" -lt 2 ]; then
    info "mniej niż dwa worktree, brak par do porównania"
  else
    tmp=$(mktemp -d) || die "mktemp nie powiodło się"
    # Path baked into the trap string at definition time, so a later $tmp change can't redirect rm.
    # shellcheck disable=SC2064
    trap "rm -rf $(printf '%q' "$tmp")" EXIT
    for ((i = 0; i < n; i++)); do
      changed_files "${paths[i]}" "$tmp/$i"
    done
    for ((i = 0; i < n; i++)); do
      for ((j = i + 1; j < n; j++)); do
        common=$(LC_ALL=C comm -12 "$tmp/$i" "$tmp/$j")
        if [ -n "$common" ]; then
          collisions=$((collisions + 1))
          info "KOLIZJA ${branches[i]} ↔ ${branches[j]}:"
          printf '%s\n' "$common" | sed 's/^/  /'
        fi
      done
    done
    [ "$collisions" -eq 0 ] && info "brak wspólnych plików"
  fi
  info ""
  cmd_list
}
# detect_test_cmd DIR - print the test command for the project in DIR, or return 1.
# Order: WT_TEST (trusted config) > DIR/.wt-test > file-based autodetection.
detect_test_cmd() {
  local dir=$1 line
  if [ -n "$CFG_WT_TEST" ]; then
    printf '%s' "$CFG_WT_TEST"
    return 0
  fi
  if [ -f "$dir/.wt-test" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in ''|'#'*) continue ;; esac
      printf '%s' "$line"
      return 0
    done < "$dir/.wt-test"
  fi
  # pnpm lockfile is checked before package.json, otherwise pnpm projects would get npm.
  if [ -f "$dir/pnpm-lock.yaml" ] && [ -f "$dir/package.json" ] && grep -q '"test"[[:space:]]*:' "$dir/package.json"; then
    printf 'pnpm test'
  elif [ -f "$dir/package.json" ] && grep -q '"test"[[:space:]]*:' "$dir/package.json"; then
    printf 'npm test'
  elif [ -f "$dir/pyproject.toml" ]; then
    printf 'uv run pytest'
  elif [ -f "$dir/Cargo.toml" ]; then
    printf 'cargo test'
  elif [ -f "$dir/go.mod" ]; then
    printf 'go test ./...'
  elif [ -f "$dir/Makefile" ] && grep -Eq '^test[[:space:]]*:' "$dir/Makefile"; then
    printf 'make test'
  else
    return 1
  fi
}

# run_tests DIR [ARGS...] - run the test command in DIR; returns its exit code.
run_tests() {
  local dir=$1 cmd rc
  shift
  cmd=$(detect_test_cmd "$dir") || {
    printf 'wt: nie wykryto komendy testowej w %s\n' "$dir" >&2
    printf 'wt: utwórz plik %s/.wt-test z jedną linią, np. "npm test", albo ustaw WT_TEST w .git/wt.conf\n' "$dir" >&2
    return 127
  }
  info "wt test: $cmd${*:+ $*}" >&2
  (cd "$dir" && bash -c "$cmd \"\$@\"" wt-test "$@")
  rc=$?
  return "$rc"
}

cmd_test() {
  local top
  repo_main
  load_config
  top=$(git rev-parse --show-toplevel) || die "nie udało się ustalić korzenia repo"
  run_tests "$top" "$@"
}
# cmd_ui - launch the curses UI (bin/wt-ui next to this script, symlinks resolved).
cmd_ui() {
  local src=$0 dir link
  while [ -L "$src" ]; do
    link=$(readlink "$src")
    case "$link" in
      /*) src=$link ;;
      *)  src="$(dirname "$src")/$link" ;;
    esac
  done
  dir=$(cd "$(dirname "$src")" && pwd -P)
  [ -f "$dir/wt-ui" ] || die "brak pliku $dir/wt-ui"
  command -v python3 >/dev/null 2>&1 || die "wt ui wymaga python3"
  WT_CMD="$src" exec python3 "$dir/wt-ui" "$@"
}
cmd_merge()  { not_implemented merge; }
# find_worktree BRANCH - print the path of the (non-main) worktree on BRANCH, or return 1.
find_worktree() {
  local want=$1 line wpath="" branch="" first=1
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "worktree "*) wpath=${line#worktree }; branch="(detached)" ;;
      "branch "*)   branch=${line#branch refs/heads/} ;;
      "")
        if [ -n "$wpath" ]; then
          if [ "$first" = 1 ]; then first=0; elif [ "$branch" = "$want" ]; then
            printf '%s' "$wpath"
            return 0
          fi
        fi
        wpath="" ;;
    esac
  done < <(git -C "$MAIN" worktree list --porcelain; echo)
  return 1
}

# cmd_drop - remove a worktree and its branch, only when nothing can be lost.
# Safe flags only (no force, no -D). --merged-pr: caller asserts the PR is merged on GitHub,
# so commits not merged locally are allowed. --check: run all checks, remove nothing.
cmd_drop() {
  local name="" check=0 merged_pr=0 usage="użycie: wt drop <temat> [--merged-pr] [--check]"
  while [ $# -gt 0 ]; do
    case "$1" in
      --check)     check=1 ;;
      --merged-pr) merged_pr=1 ;;
      -*)          die "nieznana opcja: $1" ;;
      *)
        [ -n "$name" ] && die "$usage"
        name=$1 ;;
    esac
    shift
  done
  [ -n "$name" ] || die "$usage"
  init_repo
  valid_name "$name"
  local wpath dirty pid target ahead here upref
  wpath=$(find_worktree "$name") || die "nie ma worktree na gałęzi '$name'"
  here=$(pwd -P)
  case "$here/" in "$wpath"/*) die "stoisz w tym worktree, przejdź do innego katalogu" ;; esac

  dirty=$(git -C "$wpath" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  [ "$dirty" != 0 ] && die "worktree '$name' ma niezacommitowane zmiany ($dirty), zacommituj albo odrzuć je ręcznie"

  # An owner that is the calling process itself (e.g. the UI that created it) does not block.
  if [ -f "$wpath/.wt-owner" ]; then
    pid=$(owner_field "$wpath/.wt-owner" pid)
    if [ -n "$pid" ] && [ "$pid" != "$PPID" ] && kill -0 "$pid" 2>/dev/null; then
      die "worktree '$name' jest zajęty (pid $pid), zakończ tę sesję"
    fi
  fi

  target=$(git -C "$MAIN" config --get "branch.$name.wt-target" 2>/dev/null) || target=""
  [ -n "$target" ] || target=$BASE
  git -C "$MAIN" rev-parse --verify --quiet "refs/heads/$target" >/dev/null \
    || die "gałąź docelowa '$target' nie istnieje"
  ahead=$(git -C "$MAIN" rev-list --count "$target..$name" 2>/dev/null) || ahead="?"
  if [ "$ahead" != 0 ] && [ "$merged_pr" != 1 ]; then
    die "gałąź '$name' ma $ahead commit(ów) niezmergowanych do '$target'"
  fi

  # Mirror `git branch -d` (merged into its upstream, else into HEAD) so we never end half-done.
  upref=$(git -C "$MAIN" rev-parse --verify --quiet "$name@{upstream}") || upref=HEAD
  git -C "$MAIN" merge-base --is-ancestor "$name" "$upref" 2>/dev/null \
    || die "gałąź '$name' nie jest zmergowana lokalnie (do upstreamu lub HEAD głównego checkoutu); zrób fetch/pull targetu"

  if [ "$check" = 1 ]; then
    info "można usunąć: $name"
    return 0
  fi
  # Hooks get the worktree identity via env; they run from the main checkout (the worktree is going away).
  if [ -n "$CFG_WT_PRE_DROP" ]; then
    info "uruchamiam WT_PRE_DROP: $CFG_WT_PRE_DROP"
    (cd "$MAIN" && WT_NAME=$name WT_PATH=$wpath WT_BRANCH=$name WT_MAIN=$MAIN bash -c "$CFG_WT_PRE_DROP") \
      || die "WT_PRE_DROP zakończyło się błędem, nic nie usunięto"
  fi
  git -C "$MAIN" worktree remove "$wpath" || die "git worktree remove nie powiodło się"
  if [ -n "$CFG_WT_POST_DROP" ]; then
    info "uruchamiam WT_POST_DROP: $CFG_WT_POST_DROP"
    (cd "$MAIN" && WT_NAME=$name WT_PATH=$wpath WT_BRANCH=$name WT_MAIN=$MAIN bash -c "$CFG_WT_POST_DROP") \
      || info "UWAGA: WT_POST_DROP zakończyło się błędem (nic nie cofnięto)" >&2
  fi
  if ! git -C "$MAIN" branch -d "$name" >/dev/null; then
    die "worktree usunięty, ale gałąź '$name' nie jest zmergowana lokalnie; sprawdź ją i usuń ręcznie"
  fi
  git -C "$MAIN" config --unset "branch.$name.wt-target" 2>/dev/null
  git -C "$MAIN" config --unset "branch.$name.wt-title" 2>/dev/null
  info "usunięto worktree i gałąź: $name"
}

# ----------------------------------------------------------------- main -----

case "${1:-}" in
  new)         shift; cmd_new "$@" ;;
  list|ls)     shift; cmd_list "$@" ;;
  status)      shift; cmd_status "$@" ;;
  test)        shift; cmd_test "$@" ;;
  merge)       shift; cmd_merge "$@" ;;
  drop)        shift; cmd_drop "$@" ;;
  config)      shift; cmd_config "$@" ;;
  ui)          shift; cmd_ui "$@" ;;
  *)           usage ;;
esac
